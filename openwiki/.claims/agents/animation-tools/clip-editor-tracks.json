  "claims": [
    {
      "id": "claim_6d8123b3d2154b77a3d7109fcbcaf100",
      "statement": "ClipComponentTrackRegistry discovers tracks lazily through TypeCache.GetTypesWithAttribute, skipping with a warning any type that is abstract, lacks a public parameterless constructor, does not derive from AnimationClipComponentTrack, or names a non-component type, and resolving duplicate registrations by Type.FullName order so the winner does not depend on assembly load order.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/ClipEditor/ClipComponentTrackRegistry.cs#L62-L140",
          "version": "repo-lines-v1:sha256:7fc28e969b736b30b3ff77ccd30ca2bc42fad22d9cb6f0c158df21c8ae3842d3:"
        }
      ]
    },
    {
      "id": "claim_733d5d799c864fc681682a9739c9ea7b",
      "statement": "ClipComponentTrackRegistry.FindTrackType walks a component's base chain up to but excluding AnimationClipComponent, so a track registered against an abstract component family covers every subclass.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/ClipEditor/ClipComponentTrackRegistry.cs#L22-L36",
          "version": "repo-lines-v1:sha256:2f77c85de1255ab02d8386a2190771b7790042ef4fd049d1059fb9c80bb5cc30:"
