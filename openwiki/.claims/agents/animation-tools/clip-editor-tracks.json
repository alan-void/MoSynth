        }
      ]
    },
    {
      "id": "claim_9fff76699131484a9b00d6915b2e2f67",
      "statement": "The bone position and rotation arrays handed to a clip editor overlay are SkeletonPreview's own persistent FK buffers, overwritten on the next repaint, while the SkeletonData and PoseSequence reachable from the same context are Allocator.Domain and owned elsewhere, so only SkeletonPreview's two Allocator.Persistent arrays are disposed by it.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Preview/SkeletonPreview.cs#L10-L38",
          "version": "repo-lines-v1:sha256:8883b1a624e579f21f63d4358cf65c3758f2fa6fb534e3aee220a8931f6a7345:"
