        }
      ]
    },
    {
      "id": "claim_c75790fd44bf480aafeda940351bb110",
      "statement": "A clip editor preview overlay cannot use UnityEditor.Handles because Handles draws into the current GUI or Scene view camera rather than the preview's off-screen one; overlays submit geometry through ISkeletonPreviewDrawer, which SkeletonPreviewOverlay batches into one dynamic mesh per repaint.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Preview/ISkeletonPreviewDrawer.cs",
          "version": "repo-file-v1:sha256:6fd28b86da5c8e5b29a8f6e6d4a5fa5c4654544f5a37008b11cbe8694f2f642c"
