  "claims": [
    {
      "id": "claim_30b6c195c876442f995c47e548d37143",
      "statement": "Inertialization changes the target pose instantly but computes offsets from the current pose to the target and decays them, rather than crossfading, so only one pose stream has to be kept — an upstream stage can jump anywhere without keeping the abandoned animation alive, and when nothing has jumped the offset is zero so continuous animation passes through untouched.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Inertialization/Inertialization.cs#L8-L37",
          "version": "repo-lines-v1:sha256:9b272ab31cfa520ea49f8d173c65725ce2ce6f7d382c7312c2861d8cc41b0822:"
        }
      ]
    },
    {
      "id": "claim_2a36fb439d1448059e98f327325f2999",
      "statement": "Bone 0 carries the root's world position and rotation, so blending it directly would smear the character across the world whenever the target pose comes from a different part of a clip; it is instead blended in the space of the simulation frame each pose derives and written back through the target pose's own frame, while bones 1 and up are parent-local already and blend as they are.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Inertialization/Inertialization.cs#L8-L37",
          "version": "repo-lines-v1:sha256:9b272ab31cfa520ea49f8d173c65725ce2ce6f7d382c7312c2861d8cc41b0822:"
        }
      ]
    },
    {
      "id": "claim_b45e7dcc2ca1403ea70018e557937d20",
      "statement": "Offsets are re-anchored only on the tick a stage raised PoseDiscontinuity; between jumps they simply decay, so continuous animation passes through unfiltered with no lag.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Inertialization/Inertialization.cs#L120-L197",
          "version": "repo-lines-v1:sha256:b57c6caede9927f8ecd425b54639a624280ae91aea058156fcdf7bae264b41e0:"
        }
      ]
    },
    {
      "id": "claim_f24205551f0a4922b3a83a2af7151f6e",
      "statement": "The offset is measured from the stage's own previous output rather than from the previous input pose, which is what makes a jump during an ongoing blend fold the remaining offset into the new one instead of restarting it.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Inertialization/Inertialization.cs#L120-L197",
          "version": "repo-lines-v1:sha256:b57c6caede9927f8ecd425b54639a624280ae91aea058156fcdf7bae264b41e0:"
        }
      ]
    },
    {
      "id": "claim_775308b2c2794d56827ace6ce47bcfdd",
      "statement": "Each side of a jump is read against the frame it derives for itself, so the two poses are compared as two characters each standing at their own origin.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Inertialization/Inertialization.cs#L120-L197",
          "version": "repo-lines-v1:sha256:b57c6caede9927f8ecd425b54639a624280ae91aea058156fcdf7bae264b41e0:"
        }
      ]
    },
    {
