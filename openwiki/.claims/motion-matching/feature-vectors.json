    {
      "id": "claim_b2e8832bd52e4d419825fb5b3599184b",
      "statement": "A pose is excluded from the searchable database when its sampling window would leave its own clip at either end, not just the end, because a feature vector sampling outside its clip describes a transition that never happened.",
