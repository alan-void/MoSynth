          "version": "repo-lines-v1:sha256:3a2715245c6711fa9dd20c93efb9d35aea6d56798ccfef0cdd61596716f56dd1:"
        }
      ]
    },
    {
      "id": "claim_337bad351c7f42ba9dbafb9fc9d969dc",
      "statement": "A simulation-frame feature is given bone index -1 rather than a real bone, so that anything indexing a bone with it fails loudly; a non-simulation feature whose bone cannot be resolved instead warns and falls back to the skeleton root.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Features/MmFeatureLayoutBuilder.cs#L5-L46",
          "version": "repo-lines-v1:sha256:330d7b5d33e01ce55444688175b57a1005bc1615289b869c511c1f35977131a6:"
        }
