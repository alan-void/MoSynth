    {
      "id": "claim_75cdf937de9441709ca22b5b1be69ad0",
      "statement": "PROFILE is kept separate from Unity's profiler because it accumulates minimum, maximum and rolling average across frames rather than showing one frame at a time, which is what matters for a search whose cost swings with the query; it compiles out entirely unless its define is set, and its shouting-case names are intentional so instrumentation stands out from the code being measured.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Utils/PROFILE.cs#L14-L23",
          "version": "repo-lines-v1:sha256:8ab426948e72125a1767267a319cfbf03f3ccd36d95504e930543f6b27f70b31:"
        }
      ]
    },
    {
      "id": "claim_4d264b028f124a48be3f26a2c1ee621a",
      "statement": "The PROFILE define is commented out, so the profiling helpers compile to empty bodies and the data accessor always returns null.",
      "evidence": [
