  "claims": [
    {
      "id": "claim_85fdbbfcb1d6436a80ab2dd8e82e31fe",
      "statement": "Motion matching runs playback and search on separate clocks: the playhead advances every tick while a search happens at most once per searchInterval, defaulting to ten database frames at sixty hertz.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L13-L27",
          "version": "repo-lines-v1:sha256:7f9311b6b341a455496a510c428d7180e824f75f968bdad12e50702955f83585:"
        },
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L175-L191",
          "version": "repo-lines-v1:sha256:96b367ce75dcd028dd0c6e5f0f66348c97b3b5b6252d297efd1838a0be8dc66a:"
        }
      ]
    },
    {
      "id": "claim_2461338089e845d29e1387df950eedbf",
      "statement": "A control input can force an immediate search by raising OnHighInputChange, which the stage subscribes to and uses to zero its search timer — the escape hatch that makes a coarse search interval acceptable.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L121-L145",
          "version": "repo-lines-v1:sha256:854438b426ac489aa62764efdb4dccc6d8ca6e76d49d5ed1f94bfa2fafcb6ac2:"
        }
      ]
    },
    {
      "id": "claim_b9fda204490c4939ad03b1451901d928",
      "statement": "The stage scores the frame already playing and passes that distance into the search as the initial best, so a search reports only something strictly better and returns -1 when nothing beats what is playing.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L193-L218",
          "version": "repo-lines-v1:sha256:74941442d49c32821e85bbfde50ffe6f3a033ab93acb1c46f98898bb55cd52bf:"
        }
      ]
    },
    {
      "id": "claim_85a779ef85314b0599854a821e0f8cbd",
      "statement": "A winning frame closer than minFrameSwitchDistance to the one playing is ignored, defaulting to twenty frames, because nearby frames look almost identical so jumping to one costs a discontinuity and buys nothing.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L57-L69",
          "version": "repo-lines-v1:sha256:47bb8e658f64a431f8441e10520d71a7a14dcc4d427eecd86ef70efb8788b83d:"
        },
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L193-L218",
          "version": "repo-lines-v1:sha256:74941442d49c32821e85bbfde50ffe6f3a033ab93acb1c46f98898bb55cd52bf:"
        }
      ]
    },
    {
      "id": "claim_1e23c011c4884938b062473e35736cb4",
      "statement": "The jump gate compares raw frame indices, which are global across the concatenated pose set, so a genuinely better frame a few indices away in a different clip is rejected as if it were adjacent.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L193-L218",
          "version": "repo-lines-v1:sha256:74941442d49c32821e85bbfde50ffe6f3a033ab93acb1c46f98898bb55cd52bf:"
        }
      ]
    },
    {
      "id": "claim_a78b64b68c8249dbaf4ca9eb792c9528",
      "statement": "Running off the end of a clip into the next one is treated as a pose jump exactly like a search switch, so the stage raises PoseDiscontinuity in both cases.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L220-L238",
          "version": "repo-lines-v1:sha256:5ad9ad1b55930de609925391a2bf193821ceb72507a86692e01eebe7a02385b4:"
        }
      ]
    },
    {
      "id": "claim_e5a435a63b9c4716b58a8d62af34ce91",
      "statement": "Pose features in the query come from the frame currently playing rather than from the character, which keeps the query in the database's own pose space; using the character's pose would require inverting the retargeting first.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L261-L307",
          "version": "repo-lines-v1:sha256:af80ad210c06f92334fe00ccfffdf9a217afacc38a259e7df01f0e3bdb717423:"
        }
      ]
    },
    {
      "id": "claim_1607eb6530b84843bce7d8e977a161d2",
      "statement": "The stage refuses to initialise unless the component's skeleton is structurally the rig the MotionMatchingData was built over, because the database's poses are stored over that rig.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L121-L145",
          "version": "repo-lines-v1:sha256:854438b426ac489aa62764efdb4dccc6d8ca6e76d49d5ed1f94bfa2fafcb6ac2:"
        }
      ]
    },
    {
      "id": "claim_caca347409fc43b0a1a66e4f278210c5",
      "statement": "MotionMatchingStage never overrides OnDestroy, so the search backend's Dispose is never called; this is bounded only because the search result array is allocated with Allocator.Domain.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L146-L173",
          "version": "repo-lines-v1:sha256:3f237590e4a3426909d5539b1fb79f4c14970a5196ab48808eb5a3a439aa409c:"
        },
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingSearch/MotionMatchingSearch.cs#L40-L64",
          "version": "repo-lines-v1:sha256:74e6381cb687fdcba281da51591a84f1b81cb9d9716b4e1272d5abff0af35428:"
        }
      ]
    },
    {
      "id": "claim_2e1aa1f3054548858d328ea3c71b724c",
      "statement": "UpdateFeatureWeights is never called — it carries a TODO to call it from the editor — so the responsiveness and quality inspector sliders currently have no runtime effect and weights come only from the serialized per-float list.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L309-L326",
          "version": "repo-lines-v1:sha256:865f6c3e77e7ec5aef7b8fa53f6a4d5654a50e7cdecf012bfca0485512540ec7:"
        }
      ]
    },
    {
      "id": "claim_77d42d5f087e4974a9df6fe4deb5c97c",
      "statement": "The uncalled weight-expansion method reads one weight per feature definition from the head of the very array it then fills in per float, so it must snapshot those source values before its first write or it would consume values it had already overwritten.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Core/MotionMatchingStage.cs#L309-L326",
          "version": "repo-lines-v1:sha256:865f6c3e77e7ec5aef7b8fa53f6a4d5654a50e7cdecf012bfca0485512540ec7:"
        }
      ]
    }
  ],
