  "claims": [
    {
      "id": "claim_af0fa0a1031d410d9728a71c9ffcfaf1",
      "statement": "PfnnStage runs a phase-functioned network in Python behind PythonNET rather than inside Unity, because that is the path needing no new dependency: Barracuda remains in the manifest, unused and deprecated on Unity 6.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnStage.cs#L1-L100",
          "version": "repo-lines-v1:sha256:51770cbc95ac7d9dfba9f824641a2b928b838b40f0a346210091edc2ede050e6:"
        },
        {
          "resource": "repo://Packages/manifest.json",
          "version": "repo-file-v1:sha256:1a86fc786b843d602d45ef481e42a47d5b6078502c400ed95fde1301e7e23ff8"
        }
      ]
    },
    {
      "id": "claim_1e74e12f2da94e8db6882aaea3dc7f79",
      "statement": "The past half of the stage's trajectory window comes from the character's own movement history ring rather than from the control input, because training sampled the path the character really took either side of the query frame; only the future half is a wish the controller supplies.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnTrajectory.cs",
          "version": "repo-file-v1:sha256:638bc986c060154f142bc4a57aed5b02fbb3dee683437adb3ec74f2504dda73b"
        },
        {
          "resource": "repo://Assets/Pfnn/PfnnStage.cs#L262-L305",
          "version": "repo-lines-v1:sha256:bab8aa72e8291659a435f01f08141a1e8fa4a4c7bcc5bdeaa324ebd931d16813:"
        }
      ]
    },
    {
      "id": "claim_1e72f77643a64b2890b82a17f6494f7d",
      "statement": "PfnnStage owns the model's state — gait phase, previous joints and trajectory history — while the Python policy is stateless, the opposite of MotionFieldStage, because a PFNN's state is a pose Unity must write into a PoseBuffer anyway whereas a motion field's state is a database index.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnStage.cs#L59-L95",
          "version": "repo-lines-v1:sha256:560b6c93bdbf35283318dd6f522341da09c56322640ca33a12889778b85bd677:"
        },
        {
          "resource": "repo://Python/pfnn_runtime.py#L1-L50",
          "version": "repo-lines-v1:sha256:e47dca4cef25691313a5accd0d98959cda975ad4b8905e4807b34df3db08e629:"
        }
      ]
    },
    {
      "id": "claim_a0b77f61ab1f4ca49cb48c5fc234125a",
      "statement": "The stage writes its pose in a frame at the origin and expresses the predicted root delta as bone 0's velocity channels, because MotionSynthesisComponent re-anchors bone 0 against the frame the pose implies and then accumulates the travel onto its own Transform, so an absolute frame would be applied twice.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnStage.cs#L216-L262",
          "version": "repo-lines-v1:sha256:29912ec5cec2fb0f491cd2500765bba83600d7e403dccb4e233eff9ac7066b03:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L260-L300",
          "version": "repo-lines-v1:sha256:6f322ef748726c01811cbc44bffa686fa02d284d8556836528f8365d9631c29b:"
        }
      ]
    },
    {
      "id": "claim_b0c2660be9c0479d868ca999f2e7b1bc",
      "statement": "PfnnStage clamps the predicted phase increment to be non-negative, because gait_phase builds phase as a monotone unwrapped angle so every training target was non-negative, and a negative step would run the gait cycle backwards irrecoverably.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnStage.cs#L246-L262",
          "version": "repo-lines-v1:sha256:be21e9972a8dc2532bb9f03842a727dcbbe2c10c337b83b61076986673a1f69d:"
        },
        {
          "resource": "repo://Python/gait_phase.py#L94-L142",
          "version": "repo-lines-v1:sha256:ed76647276fc361cf9a7395cbb145879491d514605cae6c262349d28c10ff73e:"
        }
      ]
    },
    {
      "id": "claim_3bb444eee11d4851a2d450b38fd30ff5",
      "statement": "PFNN needs a control-input hierarchy of its own rather than reusing MotionMatchingControlInput, because every motion matching control input resolves its prediction horizons out of a MotionMatchingData during Start and therefore cannot run on a character without a motion matching stage.",
      "evidence": [
