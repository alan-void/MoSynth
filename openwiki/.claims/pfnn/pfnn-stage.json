          "version": "repo-lines-v1:sha256:8b691d2e9e1f2952b5d3db5805bdfa30e1b01d2dd1a67b42eca420f94286b449:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/TrajectorySteeringTests.cs#L86-L116",
          "version": "repo-lines-v1:sha256:055db9ef4b1cb2e93a93b5444e692e5dbb7fe8c6db4ff91907e76b6b0da33373:"
        }
      ]
    },
    {
      "id": "claim_5a2af57678e74186a4b8f512fc6066a4",
      "statement": "PfnnDirectionControlInput damps its facing toward the direction of travel rather than assigning it, because the velocity's direction inverts in one frame as it passes through the stopped deadzone on a reversal; damping turns a 170-degree reversal gradually instead of flipping it whole.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnDirectionControlInput.cs#L88-L100",
          "version": "repo-lines-v1:sha256:35566f15992c18f7bbc679b3a923aca3fb067197f89a02a4ec81a7d1cc07161a:"
