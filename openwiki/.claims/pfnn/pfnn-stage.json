    },
    {
      "id": "claim_2ae0bd82c54847f3b3ef893452232946",
      "statement": "The trajectory gizmo is drawn once on PfnnControlInput from the packed floats PfnnStage last handed the network, taken back out of the character frame it was packed into, rather than per-subclass from each input's own desired samples — so a packing or frame error shows as a wrong picture instead of hiding behind a correct drawing of the intent, and the history half is visible at all.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnControlInput.cs#L80-L110",
          "version": "repo-lines-v1:sha256:a17db3b77244ce88c8882a32f9f3d06a1d8c5573afbd2f18f1fae1f6b40d0286:"
