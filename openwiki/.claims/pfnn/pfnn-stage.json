  "claims": [
    {
      "id": "claim_af0fa0a1031d410d9728a71c9ffcfaf1",
      "statement": "PfnnStage runs a phase-functioned network in Python behind PythonNET rather than inside Unity, because that is the path needing no new dependency: Barracuda remains in the manifest, unused and deprecated on Unity 6.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnStage.cs#L1-L40",
          "version": "repo-lines-v1:sha256:a9bed6d0978e228d934a694052beca52b871e1b8ca24c31a3c91d882136d0605:"
        },
        {
          "resource": "repo://Packages/manifest.json",
          "version": "repo-file-v1:sha256:1a86fc786b843d602d45ef481e42a47d5b6078502c400ed95fde1301e7e23ff8"
        }
      ]
    },
    {
      "id": "claim_1e74e12f2da94e8db6882aaea3dc7f79",
      "statement": "The past half of the stage's trajectory window comes from the character's own movement history ring rather than from the control input, because training sampled the path the character really took either side of the query frame; only the future half is a wish the controller supplies.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnTrajectory.cs#L1-L80",
          "version": "repo-lines-v1:sha256:e160f19076ef911df6dac174dee52cc3e316472e480d2d09c2efc8e63f5bfd3b:"
        },
        {
          "resource": "repo://Assets/Pfnn/PfnnStage.cs#L331-L369",
          "version": "repo-lines-v1:sha256:126abcd4fbd80608a1c794780b796500d831bbe4a991e8e156a74b6d29d8ec81:"
        }
      ]
    },
    {
      "id": "claim_1e72f77643a64b2890b82a17f6494f7d",
      "statement": "PfnnStage owns the model's state — gait phase, previous joints and trajectory history — while the Python policy is stateless, the opposite of MotionFieldStage, because a PFNN's state is a pose Unity must write into a PoseBuffer anyway whereas a motion field's state is a database index.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnStage.cs#L100-L125",
          "version": "repo-lines-v1:sha256:6e2e119119fc0d987b4ea7b78958107baa9911f7fb3d98783fdd8a5d034418e9:"
        },
        {
          "resource": "repo://Python/pfnn_runtime.py#L1-L50",
          "version": "repo-lines-v1:sha256:e47dca4cef25691313a5accd0d98959cda975ad4b8905e4807b34df3db08e629:"
        }
      ]
    },
    {
      "id": "claim_a0b77f61ab1f4ca49cb48c5fc234125a",
      "statement": "The stage writes its pose in a frame at the origin and expresses the predicted root delta as bone 0's velocity channels, because MotionSynthesisComponent re-anchors bone 0 against the frame the pose implies and then accumulates the travel onto its own Transform, so an absolute frame would be applied twice.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnStage.cs#L262-L280",
          "version": "repo-lines-v1:sha256:911c9c87048c44387f515636618b8e9528ce68b84ff98212fe08066b82f1b2a3:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L299-L340",
          "version": "repo-lines-v1:sha256:e9b035e33b58e46e5fc71ae493369ca2654facbf25d386cd6eedb735d3978569:"
        }
      ]
    },
    {
      "id": "claim_b0c2660be9c0479d868ca999f2e7b1bc",
      "statement": "PfnnStage clamps the predicted phase increment to be non-negative, because GaitPhase builds phase as a monotone unwrapped angle so every training target was non-negative, and a negative step would run the gait cycle backwards irrecoverably.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnStage.cs#L280-L292",
          "version": "repo-lines-v1:sha256:42c782e190a8d63980481ba6c4b3725789d5e252c874fe6fd6ee326b4e82cc28:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Animation/GaitPhase.cs#L190-L280",
          "version": "repo-lines-v1:sha256:8022beabc63a612253a77f3e4ab0c145ea77e4c7cf35ba5fad1a84adb678ffa3:"
        }
      ]
    },
    {
      "id": "claim_3bb444eee11d4851a2d450b38fd30ff5",
      "statement": "PFNN needs a control-input hierarchy of its own rather than reusing MotionMatchingControlInput, because every motion matching control input resolves its prediction horizons out of a MotionMatchingData during Start and therefore cannot run on a character without a motion matching stage; the two share only the base that owns the character reference and the player-input subscription.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnControlInput.cs#L8-L30",
          "version": "repo-lines-v1:sha256:f36464f823ca0395a244e42d14894544912be61ec24bd1742112990f82dc8a07:"
        },
        {
          "resource": "repo://Assets/MotionMatching/Runtime/CharacterController/MotionMatchingControlInput.cs#L31-L55",
          "version": "repo-lines-v1:sha256:5a12cedeb6fc89f1405aae4392b0277875cc43614c9f7bb014caef64082cb965:"
        }
      ]
    },
    {
      "id": "claim_15565ca135104f619ed20ac61e418d4d",
      "statement": "PfnnDirectionControlInput polls nothing itself; SetMovementDirection is called for it by the subscription the shared control-input base makes to UserInput's move event, and an input that has never been driven still returns a well-formed \"stand where you are\" trajectory rather than failing.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnDirectionControlInput.cs#L60-L120",
          "version": "repo-lines-v1:sha256:0b99b698f7f19230990c9968913ad8a5fe33ca4e31348a8bbf6179c518ffe84d:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/ControlInput/MotionSynthesisControlInput.cs#L46-L73",
          "version": "repo-lines-v1:sha256:97e6472ddf75574b8179dd4677c377669ef8c94be65dead7bc2f7fae3ac24baa:"
        }
      ]
    },
    {
      "id": "claim_a3c809c1dd76445d824e75e2ae850da8",
      "statement": "PfnnDirectionControlInput warns once, five seconds into play, if SetMovementDirection has never been called at all, which separates a character on which no UserInput is publishing from one legitimately asked to stand still — otherwise the same silence.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnDirectionControlInput.cs#L38-L120",
          "version": "repo-lines-v1:sha256:d0c5f2658aea6e42b69fced1323f3bb0aaed24e9c463ed3afccc4e6e80042781:"
        }
      ]
    },
    {
      "id": "claim_562f04a94cd64cc3b058f3fbf0d6e3be",
      "statement": "PfnnDirectionControlInput seeds its facing from the synthesis component's own transform forward at Awake, because a facing initialised to world +z asks a character pointing any other way to turn round on its first frame.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnDirectionControlInput.cs#L50-L62",
          "version": "repo-lines-v1:sha256:2cbab9807ffeee71ff0419794e5612bcf1abd9b4d842c5e4947c6de09df0b33b:"
        }
      ]
    },
    {
      "id": "claim_b46c689d56ac42cbb372789228278f49",
      "statement": "PfnnStage zeroes the per-bone angular velocities on the first tick after seeding, because the seed pose is the rig at rest rather than a previous animation frame, and bone 0's share of that whole-pose difference would otherwise be integrated onto the character's Transform as a tick of root motion.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnStage.cs#L196-L220",
          "version": "repo-lines-v1:sha256:563319b9e8c441df43a21d5abe3a5ca0371d859757a6d420e1d1a87af39a177a:"
        },
        {
          "resource": "repo://Assets/Pfnn/PfnnStage.cs#L348-L392",
          "version": "repo-lines-v1:sha256:ee577994cd51e02596a7f43b101b37aaac848f71fbd7e9ccf5187bd4c3d70f68:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L320-L335",
          "version": "repo-lines-v1:sha256:51024b600fe69ef3f0ff428e31da6e21d43b4e07e3a366c696c791cb31152ab4:"
        }
      ]
    },
    {
      "id": "claim_180b41753c9042b5be6cdde09c4dba91",
      "statement": "PfnnDirectionControlInput rate-limits the requested velocity through a damper before the body's controller sees it, because a keyboard delivers the request as a step and a window sample a second ahead has already converged onto it; the shared TrajectorySteering helpers are pure so the resulting continuity is asserted by tests rather than judged by eye.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnDirectionControlInput.cs#L70-L100",
          "version": "repo-lines-v1:sha256:9c98d024ef7686916891459258b605d6576f6de413c5f060c3d0bd88e933a078:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/ControlInput/TrajectorySteering.cs#L17-L30",
          "version": "repo-lines-v1:sha256:b5fe296980f188f5085d438dde2a2250be2f4137095c96cbc553fcae67ebf906:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/TrajectorySteeringTests.cs#L60-L96",
          "version": "repo-lines-v1:sha256:5842ef76a81c8ed4e16ddc18a72de91e9d40d126000a09bd54b9c3eb1edfa6c2:"
        }
      ]
    },
    {
      "id": "claim_f12ee96c5f2a4353b111bcd1187d1a6c",
      "statement": "PfnnDirectionControlInput drives its velocity with Spring.CharacterPositionUpdate, the controller for a velocity goal, rather than a position spring aimed at the requested velocity: the latter's fixed point depends on the step size rather than on the request, settling at 3.26 m/s for a 1 m/s request at 30 fps.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/PfnnDirectionControlInput.cs#L80-L95",
          "version": "repo-lines-v1:sha256:aea15a2f496f4709d8bfaa08a674485ce39edbc37f656da8a914574dd4f43f4e:"
        },
        {
