    {
      "id": "claim_a5371f000fff408da5834a38ad1e2e84",
      "statement": "The per-user Python paths live in UserSettings/MoSynthPython.json, which the standard Unity .gitignore excludes, so a machine-specific interpreter location can never travel to another machine the way the previously serialized MotionFieldConfig fields did.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Python/PythonPathSettings.cs#L25-L50",
          "version": "repo-lines-v1:sha256:813304d2e03415a0783a190e190285869aef36393439c2dd4236e97b4a2a478f:"
