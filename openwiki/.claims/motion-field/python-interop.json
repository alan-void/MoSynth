          "resource": "repo://Assets/AnimationTools/Runtime/Python/PythonRuntime.cs#L17-L30",
          "version": "repo-lines-v1:sha256:07d7e008900cce8658507a43a19df18c7870df3220e588131bc9c64a28a96b1c:"
