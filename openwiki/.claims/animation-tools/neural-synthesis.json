          "version": "repo-file-v1:sha256:502d89b525facd2e638653105fbf1d1129cd7f07368018e7bb254d4aee9e50f7"
        }
      ]
    },
    {
      "id": "claim_0aa114a9d28f451ebb094077027ca0f0",
      "statement": "CharacterSpacePose.Apply is the named inverse of Extract, taking a pose given in a character frame and writing it into a PoseBuffer; bones below the root keep their rest offsets because only their rotations are written, so a predicted pose cannot stretch a bone the way a prediction made directly in positions can.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/CharacterSpacePose.cs#L104-L232",
          "version": "repo-lines-v1:sha256:cd6c7f057386b0f046cabb4e628bcca44e44fa4feac7991dbec96b7a0ce96838:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/CharacterSpacePoseApplyTests.cs",
          "version": "repo-file-v1:sha256:ebda162cbfc76963411f490eaac72b075f96293f6713341a4aab90087ebe18d8"
        }
      ]
    },
    {
      "id": "claim_6f8786c903b343df827b8530d571fd7a",
      "statement": "The cross-language agreement between the two character-frame definitions is now measured rather than only asserted by matching properties: MoSynth/Pfnn/Check Training Agreement runs the same database frames through CharacterSpacePose.Extract and training_data.build_training_set and reports the deviation, with the residual concentrated at the deepest joints because C# composes forward kinematics in float32 and Python in float64.",
      "evidence": [
        {
          "resource": "repo://Assets/Pfnn/Editor/PfnnAgreementCheck.cs",
          "version": "repo-file-v1:sha256:5476140007851fea8499bb6b5a671c36faa4524125e908553c747065d0aec8c5"
