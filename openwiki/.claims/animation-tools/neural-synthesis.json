    },
    {
      "id": "claim_41b36fb16ea4465f9b7015ef7410f645",
      "statement": "A trajectory window is the one model input the frame-local arrays cannot supply, because the frame transform is precisely what removes it, so the training set keeps the world frame origin and heading for that purpose alone and TrainingSet.trajectory_window derives the window from them at whatever offsets a model wants.",
      "evidence": [
        {
          "resource": "repo://Python/training_data.py#L96-L150",
          "version": "repo-lines-v1:sha256:68d394951b7dd770f9f45033eb9828f2cb9777bf2acf98ebbbc90b94617d099a:"
        },
