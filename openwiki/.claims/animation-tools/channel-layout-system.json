          "version": "repo-lines-v1:sha256:1f05116f1cb32f2d0e7f05e5d40b7bef008aa927f3d12b172946c63503cad19c:"
        }
      ]
    },
    {
      "id": "claim_dfe58890714e44918958263d647daa23",
      "statement": "Sections are laid out in ascending section-key order with declaration order preserved inside a section, and each channel occupies its own width, so a section is only uniform-stride when its channels are.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/State/StateBufferLayout.cs#L16-L30",
          "version": "repo-lines-v1:sha256:7169969536a335f0ea7a9be99692b6c551e074b0848a9eb997738e91af25eaba:"
