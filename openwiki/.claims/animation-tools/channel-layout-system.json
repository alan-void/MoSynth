    {
      "id": "claim_c1b6b5b9905545ebbf023e7f90be000b",
      "statement": "StateBuffer is a view struct like NativeArray itself: copying it copies the view and every copy aliases the same underlying data, so ownership follows the Native* rule that whoever calls Allocate must call Dispose.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/State/StateBuffer.cs#L8-L20",
          "version": "repo-lines-v1:sha256:ee704bfcffb575d7a35d7892e3e9fda8014c24063f0d46e7353a70282c2346e2:"
        },
        {
