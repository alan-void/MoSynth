  "claims": [
    {
      "id": "claim_958b0e9469e14fc0b81e860d09a51ed5",
      "statement": "IPoseSetSource exists because PoseSet, PoseExtractor and PoseSerializer previously took a MotionMatchingData directly, which forced anything wanting a pose database to also be a full Motion Matching asset carrying trajectory features, pose features and a skeleton map; the interface is exactly the handful of members the pose path actually reads.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/IPoseSetSource.cs#L6-L19",
          "version": "repo-lines-v1:sha256:b01b6670a0f92adef3b3211cd1b93de95cf0029f08f74ab57998e2f6e4b1996a:"
        }
      ]
    },
    {
      "id": "claim_5269c802f01f448bb94d794244385506",
      "statement": "IPoseSetSource lives in the AnimationTools runtime assembly rather than in MotionMatching because it is generic pose-database infrastructure, not specific to any one motion-synthesis technique; MotionFieldConfig implements it to own a .mmpose database while deliberately carrying none of the feature machinery, since a motion field searches on full-body pose and velocity.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/IPoseSetSource.cs#L6-L19",
          "version": "repo-lines-v1:sha256:b01b6670a0f92adef3b3211cd1b93de95cf0029f08f74ab57998e2f6e4b1996a:"
        },
        {
          "resource": "repo://Assets/MotionField/MotionFieldConfig.cs#L9-L20",
          "version": "repo-lines-v1:sha256:e84619a65cd9d0ffe803c747def2f1c69dd3c86202989005f9c793bca74465ff:"
        }
      ]
    },
    {
      "id": "claim_8ec8c2c83bb148f7a2eb626d9cc0716f",
      "statement": "A pose is stored exactly as the clip bakes it — bone 0's world position and rotation, rest offsets and parent-local rotations below it — with nothing prepended and nothing reparented, because the character frame is derived from the stored pose on demand rather than baked into storage.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseExtractor.cs#L179-L197",
          "version": "repo-lines-v1:sha256:abe3804d88f95ea2211dd1594c4eb9d9796f972fbc5159fd44b2d598d7720b8f:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSet.cs#L9-L33",
          "version": "repo-lines-v1:sha256:96f0aec7afe97dad3865cf8400bd0723fafb0eea03332131ae8878130f5f2ca7:"
        }
      ]
    },
    {
      "id": "claim_b948b7b08ce34ab6b34fd162b6034991",
      "statement": "PoseExtractor requires the pose skeleton and the clip's own skeleton to be the same bone tree and rejects a mismatch as the clip belonging to a different rig, and PoseSetImporter.Import skips such a clip rather than failing the whole extraction.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseExtractor.cs#L19-L44",
          "version": "repo-lines-v1:sha256:4fd1da628933cdecf20dde8d98933b08e1a91c526bf306c18d1575ea64d77fd7:"
        }
      ]
    },
    {
      "id": "claim_ae8c549add2b48b2b9e3eb845d0f0d22",
      "statement": "Extraction registers one fewer pose than the clip has frames: the final clip frame is materialised only into an Allocator.Temp pose so the last stored frame can be given a forward-difference velocity.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseExtractor.cs#L19-L44",
          "version": "repo-lines-v1:sha256:4fd1da628933cdecf20dde8d98933b08e1a91c526bf306c18d1575ea64d77fd7:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseExtractor.cs#L46-L82",
          "version": "repo-lines-v1:sha256:aa6cc7f53b3b1bee886243e210ca83572d0785c8d6880d1f25111a6e14bd5c1f:"
        }
      ]
    },
    {
      "id": "claim_e98da5ce9a7a48d1821458a41dff5491",
      "statement": "Foot contact is detected by thresholding the contact bone's character-space velocity against IPoseSetSource.ContactVelocityThreshold, with no ground-distance test, and is then median-filtered with a window radius of 6 frames to remove short spurious contact and release regions.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseExtractor.cs#L221-L231",
          "version": "repo-lines-v1:sha256:57fc20a1d4aae040b2eee1b34b0693088176af60a09dda621f889c91a17a36d7:"
        }
      ]
    },
    {
      "id": "claim_e097116d55fb44c9ac6e5a67a88d7d5a",
      "statement": "The contact-detection bone is resolved by preferring an explicitly configured bone name, falling back to the BoneNameConventions heuristic, and finally to bone index 0 — the last step being a compatibility fallback that preserves the legacy behaviour of defaulting to the root joint on failure.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseExtractor.cs#L85-L102",
          "version": "repo-lines-v1:sha256:efc4ccbad6be349c8f273d051e893ab3635ba647a109ffe92d0aabd0e36f4607:"
        }
      ]
    },
    {
      "id": "claim_9a2f66fcfdd840fc8a94f3016296c6cf",
      "statement": "PoseSet storage uses Allocator.Domain and is never disposed — an outgrown buffer is abandoned to the domain after its contents are copied — so PoseSet.Dispose releases only the tag arrays, because pose sets are shared between consumers.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSet.cs#L139-L159",
          "version": "repo-lines-v1:sha256:0a36a6f87b097670853cd8a34a41342619c8dc208f102e5dfdb2022d69670c24:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSet.cs#L289-L300",
          "version": "repo-lines-v1:sha256:39087bdb34c3288982c815d3e93bea7f07638ea4594933623c2d9336a920c89a:"
        }
      ]
    },
    {
      "id": "claim_5996ff0091c446b1b91169ef9b8d17ed",
      "statement": "A PoseBuffer obtained from a PoseSet is a view aliasing the set's storage and must never be disposed by the caller.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSet.cs#L96-L127",
          "version": "repo-lines-v1:sha256:9d56f9a40dfc7d287fe5dd8bf34263a298457026f703dd4a3e5810a021e977bd:"
        }
      ]
    },
    {
      "id": "claim_1a1461a9e5554a7d8c7fa08c65ca9770",
      "statement": "PoseSet documentation refers callers to an EndClip method that does not exist anywhere in the codebase; the only real write paths are BeginClip and AppendRawFrames, the latter used by deserialization because it appends frames without clip or tag bookkeeping.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSet.cs#L96-L127",
          "version": "repo-lines-v1:sha256:9d56f9a40dfc7d287fe5dd8bf34263a298457026f703dd4a3e5810a021e977bd:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSet.cs#L9-L33",
          "version": "repo-lines-v1:sha256:96f0aec7afe97dad3865cf8400bd0723fafb0eea03332131ae8878130f5f2ca7:"
        }
      ]
    },
    {
      "id": "claim_77138c9ccbda42e9afc827f534e0dbbb",
      "statement": "Animation tags are never populated during extraction: PoseSet.AddTag is private with no callers and PoseExtractor never reads AnnotatedAnimationClip.Tag, so a freshly extracted pose set always reports zero tags and tags can only arrive by deserialization.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSet.cs#L96-L127",
          "version": "repo-lines-v1:sha256:9d56f9a40dfc7d287fe5dd8bf34263a298457026f703dd4a3e5810a021e977bd:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseExtractor.cs#L19-L44",
          "version": "repo-lines-v1:sha256:4fd1da628933cdecf20dde8d98933b08e1a91c526bf306c18d1575ea64d77fd7:"
        }
      ]
    },
    {
      "id": "claim_fa56156b0ee243ce89d8dfc1d17c8990",
      "statement": "All clips in a PoseSet must share one frame rate, asserted on both the extraction path and the deserialization path.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSet.cs#L96-L127",
          "version": "repo-lines-v1:sha256:9d56f9a40dfc7d287fe5dd8bf34263a298457026f703dd4a3e5810a021e977bd:"
        }
      ]
    },
    {
      "id": "claim_881a27c22b6748348e2708bbdebb8536",
      "statement": "Validation of a pose-set source never logs, because inspectors call it on every repaint; extraction logs instead, and the pose set is returned as null when validation fails so the caller can report through the inspector.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSetImporter.cs#L101-L131",
          "version": "repo-lines-v1:sha256:841a415194885ffd3f235192a52ce28093011ca096abbdf9662c47459e564b5a:"
        }
      ]
    }
