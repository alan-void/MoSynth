  "claims": [
    {
      "id": "claim_b8a9a1dddf404034b6dbbffd8ef0cca5",
      "statement": "The benchmark sweep queue lives on the Editor side and is pumped from EditorApplication.update rather than from a MonoBehaviour, for two stated reasons: loading path and character prefabs needs AssetDatabase, which has no business in the runtime assembly, and driving the sweep from outside the scene means no state has to survive between runs.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkDriver.cs#L11-L28",
          "version": "repo-lines-v1:sha256:f259ef06ea22d0bde194f383ee04c626dce5da6bcbd0dcd57b470da82b0943af:"
        }
      ]
    },
    {
      "id": "claim_740741f388ed48169e59621ef01af166",
      "statement": "BenchmarkLapProbe is the only runtime piece of the sweep, because it answers the one question the Editor cannot — whether the character has been round the path yet.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkDriver.cs#L11-L28",
          "version": "repo-lines-v1:sha256:f259ef06ea22d0bde194f383ee04c626dce5da6bcbd0dcd57b470da82b0943af:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Benchmark/BenchmarkLapProbe.cs#L7-L57",
          "version": "repo-lines-v1:sha256:70b6514da5a72546391aefde1534ada4327727b0f742f9699f33bfb9159db12a:"
        }
      ]
    },
    {
      "id": "claim_7d6c82c5a1f84867813698cddc124d96",
      "statement": "Runs never overlap, because two characters sharing a frame would contend for the same cores and the same Python GIL, and the cost metrics would then measure that contention rather than either method.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkDriver.cs#L11-L28",
          "version": "repo-lines-v1:sha256:f259ef06ea22d0bde194f383ee04c626dce5da6bcbd0dcd57b470da82b0943af:"
        }
      ]
    },
    {
      "id": "claim_3544ac9ee60542e2a84e8d42f572e4c1",
      "statement": "A benchmark character is instantiated under an inactive holder so Awake does not run until it has been placed and its overrides applied, because MotionSynthesisComponent seeds its pose from the transforms in Awake and a character that wakes at the origin and is moved afterwards starts with a bogus root velocity.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkDriver.cs#L253-L300",
          "version": "repo-lines-v1:sha256:be86ace978fd2d858974964832cd6c0b981108aba2145c8d1c756c257bc6ca86:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Benchmark/BenchmarkOverride.cs#L6-L30",
          "version": "repo-lines-v1:sha256:e66004dfb67434d44dd5a19257bbde646c5763e71f442f4fbff6400efba68e7c:"
        }
      ]
    },
    {
      "id": "claim_2115ab9d0914435bbca5e76edc7dc262",
      "statement": "The transform placed on the path is the synthesis component's own transform rather than the prefab root — it is what root motion drives and what every measurement reads, and in these character prefabs it sits about two metres off the root — and the character is moved by whatever delta lands that frame on the path so its internal offsets survive.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkDriver.cs#L496-L538",
          "version": "repo-lines-v1:sha256:12b02f63d981a7f1d290e19a69e3a55883478df177285433246d9d6462f0ebf2:"
        }
      ]
    },
    {
      "id": "claim_67c53bf221364266b9e99076128129ae",
      "statement": "The control input decides spawn facing and the path's own start direction is only the fallback, so a path carrying its own facing spawns the character strafing or backpedalling when that is what it was authored to do.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkDriver.cs#L496-L538",
          "version": "repo-lines-v1:sha256:12b02f63d981a7f1d290e19a69e3a55883478df177285433246d9d6462f0ebf2:"
        }
      ]
    },
    {
      "id": "claim_cab4493d52b846a18aff066b9e078f3d",
      "statement": "A sweep sets Time.captureDeltaTime so every rendered frame advances exactly one synthesis tick, decoupling the run from the wall clock and producing the same tick count every time; vsync is disabled alongside it because with frames no longer tied to real time vsync is the only thing left that would still pace them.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkDriver.cs#L166-L214",
          "version": "repo-lines-v1:sha256:73f36dc69631442d8eead0db7f1d3ccaf06f26541218977026d646a361a91259:"
        }
      ]
    },
    {
      "id": "claim_81da037d811448889a120548221476ac",
      "statement": "A finished character is destroyed with DestroyImmediate followed by an explicit GC collection, so that stage teardown — which for the motion field releases Python state — has finished before the next run's cost is measured.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkDriver.cs#L422-L432",
          "version": "repo-lines-v1:sha256:b837a04957c7c0609a312ce6f15a1f91c9bb8878ea071928c631dc10a77380e4:"
        }
      ]
    },
    {
      "id": "claim_9705064c7eb34e479121181b9c1eb238",
      "statement": "A report is written whenever any run completed, not only on success, because a sweep cut short still produced real numbers; success governs only the process exit code, and each finished run is also appended to a progress JSON-lines file as it completes so a killed sweep leaves usable data.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkDriver.cs#L434-L477",
          "version": "repo-lines-v1:sha256:f2d5b77da5d0fd09c8cac6eb86a86c489535ddf1d63bb349c048d41a9a3a3d86:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkDriver.cs#L479-L494",
          "version": "repo-lines-v1:sha256:d987c2daf10f6e6d78743626f1c6f0b0f56c44b17d59a3130858c811d4b7349d:"
        }
      ]
    },
    {
      "id": "claim_4a12dc62c8ab4b728f82d5b9df152767",
      "statement": "A run that lost its recorder or probe writes no report row at all, because recording an empty row would put a zero into the report as if it were a measurement.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkDriver.cs#L361-L414",
          "version": "repo-lines-v1:sha256:8b1a49ad47ffb811305c05e814f388bd00c45215363a2caaf096bdf6865b87fe:"
        }
      ]
    },
    {
      "id": "claim_ca758e3a140440d28ead80d5634d24f2",
      "statement": "SearchIntervalOverride is the headline quality-versus-cost dial for motion matching — searching every tick tracks better and costs more, which is what the sweep exists to quantify — and it defaults to ten database frames at sixty hertz.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Benchmark/MotionMatchingBenchmarkOverrides.cs#L31-L45",
          "version": "repo-lines-v1:sha256:3e6185f21fabe90e2f134cde46d5edcf136b2f93a4daebc42296f21427d131d6:"
        }
      ]
    },
    {
      "id": "claim_4b23582d706d4626ac5394e869c95c1a",
      "statement": "Overrides for MotionFieldConfig hyperparameters such as kNeighbors, tugRatio and the per-bone weights are deliberately absent, because those live on a shared ScriptableObject so writing them would dirty the asset and leak into every later run in the sweep; sweeping them requires a config asset per variant.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionField/Benchmark/MotionFieldBenchmarkOverrides.cs#L7-L14",
          "version": "repo-lines-v1:sha256:de73a4a48dd210c185ab98f21dc1545f5c948476e962cbd0b1f1968f75efaf9f:"
        }
      ]
    },
    {
      "id": "claim_0827ff659c744649a603ff1eb2270dd0",
      "statement": "Wall-clock cost measured inside a possibly-batchmode Editor is not player performance: it is valid only for comparing methods against each other on one machine in one sweep, which is the only claim the benchmark makes, and the JSON report records the machine and Unity version so the numbers are not accidentally compared across either.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Benchmark/SynthesisCostMetricsResult.cs#L18-L44",
          "version": "repo-lines-v1:sha256:050d8257851c224a06fbe2e1c38e03abbdcfc5501e0d78d390d9cee67966dd42:"
        }
      ]
    },
    {
      "id": "claim_08ce3d4c6c95487dba5199959d80372a",
      "statement": "The quality metrics exist to separate two methods that score identically on path following: a motion field snapping between database neighbours and a matching search jumping to a distant frame both hit their trajectory and both look wrong, and footskate and root jerk are what measure that wrongness.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Benchmark/MotionQualityMetricsResult.cs#L5-L43",
          "version": "repo-lines-v1:sha256:84304d1337c255d6afd09f305a36b6263e4897db492e537e91f293c4a25907d9:"
        }
      ]
    },
    {
      "id": "claim_0bbb764c9f8c491d8bb43d3d01f1f27f",
      "statement": "A run with no contact frames at all reports footskate as unavailable rather than zero, because no contact data means the stage never wrote foot contacts rather than that the feet never slipped, and reporting zero would score a method with no contact data as having perfect foot planting.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Benchmark/MotionQualityMetricsCalculator.cs#L116-L141",
          "version": "repo-lines-v1:sha256:7a9a2d1a48bae7153223e17197941e9f2591d4cd38604a808c17c9ba10cba690:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/MotionQualityMetricsCalculatorTests.cs",
          "version": "repo-file-v1:sha256:56c7885eea3f55a4a3e419e1b6ca7d39aca405a7c2efb59f7662fba9a48e7117"
        }
      ]
    },
    {
      "id": "claim_b8a09f46e84649fbb9f440942f37ad75",
      "statement": "Percentiles are nearest-rank rather than interpolated, because the samples are per-tick costs and jerks and the interesting figure is a value that actually occurred rather than a blend of two.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Benchmark/MetricsMath.cs#L10-L25",
          "version": "repo-lines-v1:sha256:648eec859bbd311790c060e784001ac8f986cc7696b051ae2958c7d0ea4bf436:"
        }
      ]
    },
    {
      "id": "claim_6aeee9a9315049e385bf2f3bb419e223",
      "statement": "Every metric is computed from the recording on disk rather than from live state, so a report can be rebuilt from the bin and json pair alone and the calculators stay pure and unit-testable; channels are looked up by name and treated as optional, so a narrower recording still yields whichever metrics its columns support with the rest left NaN.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/BenchmarkRunEvaluator.cs#L9-L25",
          "version": "repo-lines-v1:sha256:3aebcf067c4ff0a3495933ecb6175c13c51a19cdd6ba9ac93ef145ef81e5ddf6:"
        }
      ]
    },
    {
      "id": "claim_f4830855c4d748df8cd6b6e79ee97856",
      "statement": "Settle frames are dropped from the cost metrics as well as the quality metrics, because the first ticks of a run carry one-off setup — a motion field importing its Python modules, a search warming its caches — that would otherwise dominate the mean.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/BenchmarkRunEvaluator.cs#L88-L106",
          "version": "repo-lines-v1:sha256:04606cd237720cda7cc7d5051228adce7aac655335eb71bf393e9009fe835560:"
        }
      ]
    },
    {
      "id": "claim_416c31a3340c4c4d8c47b9484228e4c5",
      "statement": "The four standard benchmark paths are parametric and regenerable rather than hand-drawn, because nobody can say afterwards what a hand-drawn path was asking a method to do; each isolates a different demand — constant curvature, straights joined by tight ends, a reversal of turn direction, and corners no locomotion clip can follow without overshooting.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/BenchmarkPathGenerator.cs#L12-L26",
          "version": "repo-lines-v1:sha256:eb0e2f9ac237de823c67a285c082cc9a1f8c3ad9edfcdfbb9ab2230d7658c567:"
        }
      ]
    },
    {
      "id": "claim_d3962f9fb3a04a3ca5766fdfc989154c",
      "statement": "The headless invocation must not pass -quit, because a sweep runs in play mode and the entry method returns long before it finishes; batchmode Unity stays alive after -executeMethod returns on its own, and the driver calls EditorApplication.Exit with the sweep's status code once the report is written.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkCli.cs#L8-L23",
          "version": "repo-lines-v1:sha256:060b9e24f45ccd567321c0a0968611d58f8336fb9e1873ced83aaf6b96438b91:"
        },
        {
          "resource": "repo://Tools/run-benchmark.ps1",
          "version": "repo-file-v1:sha256:527e0928d403645d4cdaaeb345c5bfd8984d29267fc03286067d6ca764d74cbe"
        }
      ]
    },
    {
      "id": "claim_c6aaf8945a3f484f9d0086ce064b261b",
      "statement": "A random benchmark path's geometry is a pure function of its kind, seed and slot, and the seed and slot are carried in the prefab name, so a report row identifies the exact curve it was measured on and the same seed rebuilds it; the per-slot sub-seed rather than one stream shared across the batch is what keeps a path independent of how many others were generated beside it.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/RandomPathShapes.cs#L60-L88",
          "version": "repo-lines-v1:sha256:dcff24de532b74acb5ff468e940e57a4dba174b8ee9dc0b356147ec268bbe8d7:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/RandomBenchmarkPathGenerator.cs#L9-L25",
          "version": "repo-lines-v1:sha256:0450c8dd27f4c379a625a4a6a46b3fe9da9ca0db9bc8bcd16b207e4cf3f2d71a:"
        }
      ]
    },
    {
      "id": "claim_3ebbf9238c8a48a2b0681087e8a3cd53",
      "statement": "Random paths are written to a subfolder of the folder the sweep scans, and the driver's folder-scoped asset search recurses into it, so a generated batch joins every later sweep with no config edit — which also means a stale batch left in place silently adds its runs to every run of the suite.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/SynthesisBenchmarkDriver.cs#L562-L606",
          "version": "repo-lines-v1:sha256:7deffbca7311421ab2c70cfb287e8e6b243e42e673bb359f3a2bf93034e230a7:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/RandomBenchmarkPathGenerator.cs#L27-L79",
          "version": "repo-lines-v1:sha256:daf7545c1c4f58b89bc2ecb05acc55acd7805805e28f4c64866f3913c2813cd1:"
        }
      ]
    },
    {
      "id": "claim_1c3a4c1dee614775bf3819f16d2bece3",
      "statement": "A random path candidate is rejected and redrawn unless it clears a minimum turn radius (smooth families) or a minimum corner separation and turn angle (sharp families), because a path no locomotion clip can follow measures nothing; on exhaustion the generator skips the slot rather than writing a path that fails its own contract.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/RandomPathShapes.cs#L60-L135",
          "version": "repo-lines-v1:sha256:b0c10dcb2594faab2fc02d4215e836b0be48b4ac4ccdd2cb81ba9f2b5663093c:"
        }
      ]
    },
    {
      "id": "claim_1dc102303b5d4fc0b2b8aade6cdb4bc2",
      "statement": "Random paths are rejected for approaching themselves closer than a clearance bound, not merely for crossing: the windowed spline projection already survives a clean crossing, but two branches running close and parallel let its search slide onto the wrong one, which the lap tracker then reads as a seam crossing and turns into a phantom lap.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/RandomPathShapes.cs#L313-L355",
          "version": "repo-lines-v1:sha256:13cbe0b61b346b623c01a1b99e0dcdb1249473771dac988051da6b6662967699:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Evaluation/SplineProjector.cs#L6-L28",
          "version": "repo-lines-v1:sha256:8c8e261c5513e9982137ec129f7a1e48a0a2964c3a102406ec008d6d5ab6ca5c:"
        }
      ]
    },
    {
      "id": "claim_e0f2589123624463af154f9918daac02",
      "statement": "Open random paths are generated as a corridor advancing monotonically along one axis rather than as an unclosed ring, because a ring's start and end sit one segment apart, which would make reaching the far end geometrically indistinguishable from being back at the start and would point a pure-pursuit lookahead across the gap; the monotone axis also makes the polyline the graph of a function and so incapable of self-intersection.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Benchmark/RandomPathShapes.cs#L186-L232",
          "version": "repo-lines-v1:sha256:e4a273560375933babbae8643d712d71bc1a51ee0538a258f5b667810ac3bd1c:"
        }
      ]
    },
    {
      "id": "claim_a1ccfdb8d01849ba8fccf876ba1581e8",
      "statement": "The constant-speed spline follower clamps its normalized path parameter on an open spline instead of wrapping it, through a Fold helper over a virtual IsClosed seam; wrapping teleported the predicted trajectory back to the path's start about one prediction horizon before the reference reached the end, so the character was steered into a return leg, never reached the far end, and the run could only finish by timing out.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/CharacterController/SplineControlInput.cs#L45-L62",
          "version": "repo-lines-v1:sha256:54aa33c133e1e3f69154fa2e057cecde9673d07171a77c39baf7ffa5540fe693:"
        },
        {
          "resource": "repo://Assets/MotionMatching/Runtime/CharacterController/SplineControlInput.cs#L145-L190",
          "version": "repo-lines-v1:sha256:33583827e6e7560ff46fd324c667c5a745d99cf9e7df7dc22f93b3a51d23f22c:"
        }
      ]
    },
    {
      "id": "claim_33560cabc652493198e1295ea8f696af",
      "statement": "On an open path a benchmark run finishes on reaching the far end rather than by counting laps, so lapsRequired is ignored and the reported completedLaps reads as the fraction of the path covered rather than as a lap count.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Benchmark/SplineLapTracker.cs#L17-L90",
          "version": "repo-lines-v1:sha256:c4f4db2b58083c1a215680cb4352120600131e3baa8d7a3e44b63b1d3498d99f:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Benchmark/BenchmarkLapProbe.cs#L47-L106",
          "version": "repo-lines-v1:sha256:286854f521eb53287f3b1c850ada3d86b76b493aae70cf3ccdfa84f2620511e6:"
        }
      ]
    }
  ],
