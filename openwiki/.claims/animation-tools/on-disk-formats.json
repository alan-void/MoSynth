    },
    {
      "id": "claim_26600d63dae944a397e37baa0ada7115",
      "statement": "A .mmfeatures header records the trajectory and pose feature counts so the file describes its own trajectory/pose split, which is what lets a reader outside Unity find the pose block without a MotionMatchingData asset to consult.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Features/FeatureSerializer.cs#L61-L80",
          "version": "repo-lines-v1:sha256:6592a8d9418ee98798320714cdd5dae4fb5da84494c31f83ca0dfc211504c5ca:"
