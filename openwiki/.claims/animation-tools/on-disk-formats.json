  "claims": [
    {
      "id": "claim_329681e9f5624decb6f3f8c4c50d2da1",
      "statement": "The binary convention across MoSynth's own formats is components in order, little-endian float32, with no length prefix and no padding — arrays are their elements back to back, which is why the read helpers must be told a length — and this plain layout is what lets the Python side read the files with one numpy.fromfile and a reshape. Quaternions are xyzw throughout.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Utils/BinarySerializerExtensions.cs#L10-L19",
          "version": "repo-lines-v1:sha256:e0e0e59ce280e4f6f0cc09a3827066e482102c213db23e492de18515a42cd241:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Utils/BinarySerializerExtensions.cs#L45-L51",
          "version": "repo-lines-v1:sha256:4d8f9fcf0d65c5cd9d2315380cc45cab1dddcb94ca69a986a3d3e7941b775c77:"
        }
      ]
    },
    {
      "id": "claim_b1ced389118847bfbc71db82a0ab6b66",
      "statement": "A .mmpose file carries a skeleton block ahead of the poses that C# does not need — a config reads rest pose live off its own Transforms — but which the Python half requires, having no ScriptableObject to read: joint names key the bone-weight table, parent indices drive FK, and rest offsets give root-space positions.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSerializer.cs#L224-L245",
          "version": "repo-lines-v1:sha256:74033c6765899f402190d667fa17231c567471d84c599afd5edd727dfb840e53:"
        },
        {
          "resource": "repo://Python/pose_set_importer.py#L35-L50",
          "version": "repo-lines-v1:sha256:293cc7321897ba0c4c980f52159a4aff85a50a799ccf88b8c63dc52226397783:"
        }
      ]
    },
    {
      "id": "claim_52656d8571334c8fb7fc1fe78d252e95",
      "statement": "The skeleton block is kept inside the pose file rather than in a companion file because a separate .mmskeleton file previously allowed the two to drift apart.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSerializer.cs#L224-L245",
          "version": "repo-lines-v1:sha256:74033c6765899f402190d667fa17231c567471d84c599afd5edd727dfb840e53:"
        },
        {
          "resource": "repo://Python/pose_set_importer.py#L35-L50",
          "version": "repo-lines-v1:sha256:293cc7321897ba0c4c980f52159a4aff85a50a799ccf88b8c63dc52226397783:"
        }
      ]
    },
    {
      "id": "claim_bf98e1a83b89431ea183f9bc828ba8fa",
      "statement": "No MoSynth binary format carries a magic number or version header, so the .mmpose skeleton block is what stands in for one: comparing bone names and parent indices against the live skeleton is the mechanism that detects a database extracted over a different rig, or over the same rig before its bone list changed.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSerializer.cs#L247-L288",
          "version": "repo-lines-v1:sha256:4d4a389e5d367478ca50b6201b9f889ea114ec340bed25abe2e2ae179f27a22c:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/PoseSerializerTests.cs#L129-L148",
          "version": "repo-lines-v1:sha256:93fd2f00e0a3c34ef9adf539de93927ba90e57fb48ea4dfc4fdd8f0322312ae8:"
        }
      ]
    },
    {
      "id": "claim_0817f889d2474f34a6631fb5572c0534",
      "statement": "Deserialization rejects a stale .mmpose with three distinct diagnostics — differing bone count, differing bone name at an index, and differing parent index — each naming the offending bone and instructing the reader to regenerate the database; a differing parent index is caught even when names and bone count both match.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSerializer.cs#L247-L288",
          "version": "repo-lines-v1:sha256:4d4a389e5d367478ca50b6201b9f889ea114ec340bed25abe2e2ae179f27a22c:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/PoseSerializerTests.cs#L150-L166",
          "version": "repo-lines-v1:sha256:af72b1272592851fbd470dc8b728487a6987757851052c238dd3635a4b451d37:"
        }
      ]
    },
    {
      "id": "claim_4bde090d923d4a00bdd2d0e43997c999",
      "statement": "The bone count appears twice in a .mmpose, once in the skeleton block and once in the pose header, and the second copy exists solely to detect a truncated or corrupt write, since the first has already been reconciled against the live asset.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSerializer.cs#L113-L124",
          "version": "repo-lines-v1:sha256:3d088fa734a89bc0608aaad448d7880f7e6191f370be269715df182f3b371e7b:"
        }
      ]
    },
    {
      "id": "claim_fcbaf5f3dc0c41c1b12ad3e78b6a95d3",
      "statement": "The simulation frame is never written to disk: both the C# and Python halves derive it from bone 0's rest rotation, which the skeleton block's bone entries already carry.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSerializer.cs#L224-L245",
          "version": "repo-lines-v1:sha256:74033c6765899f402190d667fa17231c567471d84c599afd5edd727dfb840e53:"
        },
        {
          "resource": "repo://Python/pose_set_importer.py#L35-L50",
          "version": "repo-lines-v1:sha256:293cc7321897ba0c4c980f52159a4aff85a50a799ccf88b8c63dc52226397783:"
        }
      ]
    },
    {
      "id": "claim_028f64814b7b4013be5740e5f25d485c",
      "statement": "Strings in .mmpose are the one place the no-length-prefix rule does not hold, because C# BinaryWriter prefixes them with a LEB128 7-bit-encoded length that the Python importer must decode by hand; this applies to bone names and tag names.",
      "evidence": [
        {
          "resource": "repo://Python/pose_set_importer.py#L13-L32",
          "version": "repo-lines-v1:sha256:42005c07a0ee85305850d77297ce2a6502e344e7f687e35f0da6fb5306bf6949:"
        }
      ]
    },
    {
      "id": "claim_bf1c259db5664b7eb9eabf0bdafa1d2e",
      "statement": "Bone 0's parent index of -1 is written as an unsigned 0xFFFFFFFF and read back as signed -1 by C#, while the Python importer reads the same bytes directly as a signed int.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSerializer.cs#L224-L245",
          "version": "repo-lines-v1:sha256:74033c6765899f402190d667fa17231c567471d84c599afd5edd727dfb840e53:"
        },
        {
          "resource": "repo://Python/pose_set_importer.py#L35-L50",
          "version": "repo-lines-v1:sha256:293cc7321897ba0c4c980f52159a4aff85a50a799ccf88b8c63dc52226397783:"
        }
      ]
    },
    {
      "id": "claim_231cd1ebd5b842459aaed5d201dd6533",
      "statement": "Generated artefacts live in StreamingAssets under a folder per source asset, named StreamingAssets/<domain>/<asset-name>/, where the asset name doubles as both the folder name and the file base name; MotionMatchingData uses the MMDatabases domain and MotionFieldConfig uses MotionFields, deliberately kept separate because the Motion Matching inspector owns and regenerates its own folder.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSetImporter.cs#L133-L147",
          "version": "repo-lines-v1:sha256:4df9a768e3e9c7cc1489981cba20701d9ed4f2c2cdf169dfec9ffd8e39d33639:"
        },
        {
          "resource": "repo://Assets/MotionField/MotionFieldConfig.cs#L233-L247",
          "version": "repo-lines-v1:sha256:a0d4bfc75032c8e5144449f8ebee433aa929d48149a667e3f9f407c0f8933d70:"
        }
      ]
    },
    {
      "id": "claim_e12e8a5106084817acb9dde958446082",
      "statement": "When no serialized .mmpose is found, the importer warns, extracts the database at runtime, and in the Editor writes the result back to disk, so the fallback is paid for only once.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSetImporter.cs#L101-L131",
          "version": "repo-lines-v1:sha256:841a415194885ffd3f235192a52ce28093011ca096abbdf9662c47459e564b5a:"
        }
      ]
    },
    {
      "id": "claim_877eecf556754466b34402f0beb5b40c",
      "statement": "A motion recording is a raw float32 .bin plus a sidecar JSON manifest that describes the data well enough to load it with numpy alone and no AnimationTools code, the manifest carrying per-channel float offsets and a flattened mirror of the pose layout including bone names.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Recording/RecordingManifest.cs#L7-L36",
          "version": "repo-lines-v1:sha256:2e8a55c87d30c0ef0192178d4992f88c8d5d55b4c12b95e9aeed87468c8ec07d:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Recording/BuiltInRecorderChannels.cs#L220-L243",
          "version": "repo-lines-v1:sha256:dd93ab841cb1b40d8448b53b405aa033fd39fe6667c5bf218510d384db120f0a:"
        }
      ]
    },
    {
      "id": "claim_72d9f7d537164aeb8d52833273e2e1bd",
      "statement": "The recording manifest is the only MoSynth format carrying a formatVersion field, and nothing reads it — RecordingReader validates frameFloatCount and tolerates a file shorter than the manifest claims after a crash, but never inspects the version — so even that version is decorative.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Recording/RecordingManifest.cs#L7-L36",
          "version": "repo-lines-v1:sha256:2e8a55c87d30c0ef0192178d4992f88c8d5d55b4c12b95e9aeed87468c8ec07d:"
        }
      ]
    },
    {
      "id": "claim_02818da3b9b04d35bd7670eea3c8626b",
      "statement": "The .mmfeatures file is kept separate from .mmpose on purpose, because features are one way of indexing poses for search and changing them should not force re-extracting the poses; like the other binary formats it is unversioned, so a stale file is misread rather than detected.",
      "evidence": [
        {
          "resource": "repo://Assets/MotionMatching/Runtime/Features/FeatureSerializer.cs#L10-L19",
          "version": "repo-lines-v1:sha256:24d92e4d714458d095cafea451e8f94b16b6d5b97cb2fbda0e9df4c98cb4340b:"
        }
      ]
    },
    {
      "id": "claim_ba412a8decfe43948ff8c3bd800db8b9",
      "statement": "PoseSerializer.Deserialize guards against short reads using NUnit.Framework.Assert, placing a test-framework dependency inside the runtime assembly.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSerializer.cs#L113-L124",
          "version": "repo-lines-v1:sha256:3d088fa734a89bc0608aaad448d7880f7e6191f370be269715df182f3b371e7b:"
        }
      ]
    },
    {
      "id": "claim_08e796a151d346bfb58fe0566dd6a0ee",
      "statement": "PoseLayout declares a PoseFormatVersion constant of 1, but it has no usages anywhere in the codebase and PoseSerializer writes no version or magic number, so it is a dead constant rather than a format version.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseLayout.cs#L42-L46",
          "version": "repo-lines-v1:sha256:b725ae2cec272118fb768d5f824a5760666890bc25727b13a417221b24807cd9:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseSerializer.cs#L21-L40",
