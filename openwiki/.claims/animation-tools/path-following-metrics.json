  "claims": [
    {
      "id": "claim_0d4acbd5bbde4c248c3fb5601cbd1687",
      "statement": "SplineProjector searches only a window around the previous result so the projection tracks along the path, because SplineUtility.GetNearestPoint searches the whole spline and on a self-crossing path the globally nearest point flips to the other branch at the crossing — taking every consumer with it.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Evaluation/SplineProjector.cs#L6-L29",
          "version": "repo-lines-v1:sha256:f40624523f107c176a2921da392cf7f463355094bd4aea13d89b7ad65dfffd25:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/SplineProjectorTests.cs",
          "version": "repo-file-v1:sha256:2ca4a6815b95dea9813586c8e5e3520a89ad2cec0608d860fe5b6ec2a532c217"
        }
      ]
    },
    {
      "id": "claim_2540f87a6f21417985bb17f2faa50022",
      "statement": "The Unity Splines package offers no windowed nearest-point overload: both public GetNearestPoint forms hardcode a full-spline range, the range-aware internals are private, and SplineSlice is limited to whole knots and documents itself as unsuited to per-frame use — so the projector mirrors the package's own coarse-to-fine chord search over a caller-controlled window.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Evaluation/SplineProjector.cs#L6-L29",
          "version": "repo-lines-v1:sha256:f40624523f107c176a2921da392cf7f463355094bd4aea13d89b7ad65dfffd25:"
        }
      ]
    },
    {
      "id": "claim_7d77f23512fe41d19eb3c116ab54f81c",
      "statement": "The search window is sized from the point's own displacement rather than fixed, so one projector serves both a 30 Hz controller stepping centimetres and a coarse recording stepping metres; re-acquisition by global search is deliberately reluctant because re-acquiring is precisely what must not happen at a crossing.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Evaluation/SplineProjector.cs#L31-L61",
          "version": "repo-lines-v1:sha256:9784ccf8ece34f8416456789e5a9a5f513b20a2851541203ecdab2bad4237504:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Evaluation/SplineProjector.cs#L87-L119",
          "version": "repo-lines-v1:sha256:baad7bfa8234ea2f462b72011b8bf64a4e71646903eee52c0eedce139de79079:"
        }
      ]
    },
    {
      "id": "claim_9c045447a3ce4ca687f411effa1546c6",
      "statement": "Expressing the search window in metres is valid because normalized spline parameters are uniform in arc length, so a window of d metres is d divided by spline length in normalized space anywhere along any spline.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Evaluation/SplineProjector.cs#L6-L29",
          "version": "repo-lines-v1:sha256:f40624523f107c176a2921da392cf7f463355094bd4aea13d89b7ad65dfffd25:"
        }
      ]
    },
    {
      "id": "claim_303177f68b374d96a339edcf1ff5ae78",
      "statement": "The metrics calculator walks one projector forward across the analysis frames rather than re-deriving per frame, because a global projection would flip branches at a crossing and manufacture a roughly 180 degree heading error out of a run that never left the path.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Evaluation/PathFollowingMetricsCalculator.cs#L109-L120",
          "version": "repo-lines-v1:sha256:1a403e43777d19f8251c30d068206294019a9f344ba85ef1ef878aa0a651bf6c:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/PathFollowingMetricsCalculatorTests.cs",
          "version": "repo-file-v1:sha256:5335ebb129c6f044d9b29269cbb0108cd038bca5485d2ee4e937e5576bcf3fec"
        }
      ]
    },
    {
      "id": "claim_b448e04e26324f97954a01b11e9821be",
      "statement": "Lap completion is measured from the character's own progress rather than derived from path length divided by target speed, because MotionFieldSplineControlInput reports NaN target speed — its policy has no speed model — and because measuring actual progress keeps the comparison honest, giving a method that falls behind a longer run rather than a truncated lap.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Benchmark/SplineLapTracker.cs#L3-L16",
          "version": "repo-lines-v1:sha256:6b547d9103de010bba8a4369d1874547a3188e2881cfe76f2b50ea968b66f714:"
        },
        {
          "resource": "repo://Assets/MotionField/MotionFieldSplineControlInput.cs#L36-L44",
          "version": "repo-lines-v1:sha256:946bfcfed158a2706dbb408a0119cd51b7ccbbf8cbe13c8f3df6414a19c321e1:"
        }
      ]
    },
    {
      "id": "claim_1085f650773940cdaca1e88fba6d1752",
      "statement": "Closed splines accumulate signed per-tick deltas wrapped into plus or minus half a lap, which lets a run survive the parameter wrapping from 1 to 0 while treating the backward jitter a synthesized root produces every gait cycle as negative progress rather than as a completed lap.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Benchmark/SplineLapTracker.cs#L52-L89",
          "version": "repo-lines-v1:sha256:905e365b845e584b311096e3880a88aad92ebd6be82884c772fe8ea16c8b918a:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/SplineLapTrackerTests.cs",
          "version": "repo-file-v1:sha256:8e3f09b3b39f79f03a4da60b013c9e4fc1fc0b3091d618f155360d6f4b85f5ac"
        }
      ]
    },
    {
      "id": "claim_7c31f01a52d545438eed46772674e6f3",
      "statement": "An open spline counts as finished at parameter 0.995 rather than 1.0, because the nearest point to a character that has run past the end clamps to the final knot and a strict test would still reject it on floating point.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Benchmark/SplineLapTracker.cs#L19-L24",
          "version": "repo-lines-v1:sha256:64823ea4885fe6c56a68373330eb2744173ff860f13b8c1cc49e66a49ca0417e:"
        }
      ]
    },
    {
      "id": "claim_5c9fb8e939444ed6bcc9dcccc497e4e4",
      "statement": "Speed is smoothed with a centred moving average of about 0.2 seconds before velocity error is computed, because per-tick speed is dominated by synthesis jitter that would inflate the error; centred rather than trailing so the smoothed speed stays time-aligned instead of lagging by half a window.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Evaluation/PathFollowingMetricsCalculator.cs#L207-L227",
          "version": "repo-lines-v1:sha256:65dcce47fa423f341b744999c3a4b3733089166cb8c1c1987fa17280dfa6a1b8:"
        }
      ]
    },
    {
      "id": "claim_3cc3fcd2879841ba96e4b158ceb4c5e7",
      "statement": "Heading error is computed with an atan2 form rather than acos of a dot product, because acos loses precision for nearly-parallel directions.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Evaluation/PathFollowingMetricsCalculator.cs#L133-L152",
          "version": "repo-lines-v1:sha256:f55a5d3db3947cf1964ecda21b8c987fca87f56d633767003ac6c6c181f8098e:"
        }
      ]
    },
    {
      "id": "claim_66f219bf5be64e629b38c3ae7d7a9973",
      "statement": "Actual speed is obtained by finite-differencing the recorded root positions between successive analysis frames in the ground plane and dividing by the recorded time delta, skipping any pair whose delta is not positive; the smoothing window is then sized from the mean of those deltas rather than from the configured frame rate.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Evaluation/PathFollowingMetricsCalculator.cs#L182-L199",
          "version": "repo-lines-v1:sha256:533d38e201f76b6e092ec7702ac6912f47628627c13b31b8ea814cd93e4f88bc:"
        }
      ]
    }
  ],
