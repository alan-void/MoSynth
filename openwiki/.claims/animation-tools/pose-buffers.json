          "version": "repo-lines-v1:sha256:dcd62cdafb92bc2eb3e32065c73ce1c9e3c2996372fd287bccd5a5a33d55172b:"
        }
      ]
    },
    {
      "id": "claim_ed11152cac704318828e586ccef280b0",
      "statement": "When both contact sides resolve to the same bone the builder forces them apart, because the layout rejects duplicate channel identities and a skeleton missing one foot must still end up with two distinct host bones.",
