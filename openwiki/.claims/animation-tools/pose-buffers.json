  "claims": [
    {
      "id": "claim_8d140b6a9e044bd3a43707e7b986dead",
      "statement": "A PoseLayout is the pose file's own self-description: a serialized pose asset stores enough of it to reconstruct the layout without external context, which is what lets a deserialized database be read with no ScriptableObject to consult.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseLayout.cs#L33-L52",
          "version": "repo-lines-v1:sha256:819fd083ae288185dc0ba505fd12de2c1453100d5e0cd467ff370c841ea017fa:"
        }
      ]
    },
    {
      "id": "claim_789e0dfa465641cb92df511d799be1c6",
      "statement": "Structurally equal skeletons from different sources share one cached PoseLayout instance, and that shared instance is what lets PoseBuffer.CopyFrom work between a PoseSet's frames and a live component's frames, since CopyFrom requires equal layout hashes.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseLayout.cs#L33-L52",
          "version": "repo-lines-v1:sha256:819fd083ae288185dc0ba505fd12de2c1453100d5e0cd467ff370c841ea017fa:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/PoseLayoutTests.cs#L267-L275",
          "version": "repo-lines-v1:sha256:2a605b032b95f67de00a90afd69b87efc40d48a046e9070d9b4566464ac451e1:"
        }
      ]
    },
    {
      "id": "claim_9fc3d1fac4b34866973111a509dfd67b",
      "statement": "The PoseLayout cache evicts an entry whose rig Transform was destroyed by a reimport or scene unload, because such an entry reports zero bones and can never match again, so leaving it would poison its slot permanently.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseLayout.cs#L126-L150",
          "version": "repo-lines-v1:sha256:8aca72b408ac9677019bcec379c2cc5793f93f0f01d4be080cc7dda499be67bb:"
        }
      ]
    },
    {
      "id": "claim_4e5ba5bdedef4340a736a04adfe4afe2",
      "statement": "On a hash collision between structurally different skeletons the fresh layout is left uncached rather than evicting the incumbent, trading the cache benefit for correctness so the other skeleton's shared-instance guarantee survives; the cache key is the hash but membership is always confirmed with a structural-equality check.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseLayout.cs#L126-L150",
          "version": "repo-lines-v1:sha256:8aca72b408ac9677019bcec379c2cc5793f93f0f01d4be080cc7dda499be67bb:"
        }
      ]
    },
    {
      "id": "claim_04f0f30629684898a3e87daaeb48a1be",
      "statement": "Every Rotation channel in one layout must share a single rotation representation, which is what keeps the Rotation section uniform-stride and therefore lets PoseBuffer.Rotations exist as a reinterpreted quaternion slice.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseLayout.cs#L94-L124",
          "version": "repo-lines-v1:sha256:1f05116f1cb32f2d0e7f05e5d40b7bef008aa927f3d12b172946c63503cad19c:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/PoseLayoutTests.cs#L130-L139",
          "version": "repo-lines-v1:sha256:0c69e9a98dfbfdd0eb03cf01b25069b517e094b886053c02ff001bac657ce024:"
        }
      ]
    },
    {
      "id": "claim_af026b2393244e0e82bdd9ce0d2478e1",
      "statement": "PoseLayout's named sections describe only the six built-in channel kinds and explicitly do not assume they span the buffer; ExtraStart and ExtraCount cover the contiguous tail any further sections form.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/PoseLayout.cs#L6-L31",
          "version": "repo-lines-v1:sha256:3aa97c304278762f8f89e8192c167741bc6d9116a49bb1c9c33f26c7d5d61e64:"
