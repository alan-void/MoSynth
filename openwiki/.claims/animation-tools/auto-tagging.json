    {
      "id": "claim_28c35c4e2e5244f5a99898e29d497a98",
      "statement": "Auto-tagging runs in three stages sharing one run folder under Library/AutoTag: Unity renders each clip to MP4 plus a manifest, a Python CLI asks Gemini for tag frame ranges and writes results.json, and Unity applies the results to AnimationTagComponent channels.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/AutoTag/AutoTagWindow.cs",
          "version": "repo-file-v1:sha256:3beb00ab95cc58a579184dd943d3707e429d1f72b8a6384805e2584ce34c788a"
        },
        {
          "resource": "repo://Python/autotag/annotate.py",
          "version": "repo-file-v1:sha256:780fbe5049dcc6f61a69a2c7bb462c5c5413e8a4f992b1dcb56861507e4bec50"
        }
      ]
    },
    {
      "id": "claim_1e01103d5f9144f480c1dd86b1d03bf4",
      "statement": "A tag's meaning for the model comes from the description field on GameplayTagSO; ancestor descriptions are sent as context.",
