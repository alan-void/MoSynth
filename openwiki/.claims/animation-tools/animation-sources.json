    {
      "id": "claim_17247bd5de454603bc610632907b8738",
      "statement": "AnimationClipBaker.TryValidateClip accepts a clip as soon as it animates one skeleton bone rather than all of them, because rigs routinely leave leaf bones uncurved — the project's own clips animate 72 of 85 bones, the other 13 being FBX \"_end\" markers, so demanding full coverage would reject every asset in the repository.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Animation/AnimationClipBaker.cs#L26-L42",
          "version": "repo-lines-v1:sha256:2eadb15425229d16f3f32f937d457d9c5b308c4a920dc05601883ec92af7297e:"
        },
        {
