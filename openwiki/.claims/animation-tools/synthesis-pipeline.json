          "version": "repo-lines-v1:sha256:e140462526b93f067d5a91f294b866fa7715590d0e24362aacb51f4ee3c5f0cf:"
        }
      ]
    },
    {
      "id": "claim_7d52409d2c784c6181439a28567601e6",
      "statement": "Extension points in this codebase live in the assembly that depends on AnimationTools rather than in AnimationTools itself, so a concrete implementation sits next to the thing it pokes; exactly four of these are [SerializeReference] inspector seams — MoSynthStage, RecorderChannel and BenchmarkOverride as lists, and MotionMatchingSearch as a single field — while MotionMatchingControlInput is an abstract MonoBehaviour and IMatchingFeature and IPoseSetSource are interfaces instantiated in code.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Benchmark/BenchmarkOverride.cs#L6-L18",
          "version": "repo-lines-v1:sha256:3cb1c5c14844ae7e035437a3c8912db0718a5798802d091f8274c7375fa527ad:"
        },
        {
