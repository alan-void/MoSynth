  "claims": [
    {
      "id": "claim_31015872ba13458ebe5c369a0da163ea",
      "statement": "MotionSynthesisComponent owns the skeleton, the pose layout, the buffers, the scene-rig binding, the frame loop and the write-back to Transforms; MoSynthStage owns synthesis and nothing else, rewriting the pipeline pose in place.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MoSynthStage.cs#L5-L19",
          "version": "repo-lines-v1:sha256:5ddcfc9be3c0a640f5b03d74d27efed5df8acc196c7944f4f69b6f65e7db9339:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L10-L30",
          "version": "repo-lines-v1:sha256:f6fb87337c47af849918932ea76a35797c8cb518b5ae83806edb8adaa86f6a38:"
        }
      ]
    },
    {
      "id": "claim_911a8a2e0d1349e9891aa68918b22081",
      "statement": "A stage is a plain [Serializable] class rather than a MonoBehaviour, so the four callbacks are all it gets and they run in the list's declaration order rather than under Unity's component lifecycle; consequently OnDestroy is the only place native collections can be released.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MoSynthStage.cs#L11-L17",
          "version": "repo-lines-v1:sha256:67e28001f83aa4cbe337f9c0d53b0da3b739b8740e346b41b252591edc81c7e3:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MoSynthStage.cs#L60-L63",
          "version": "repo-lines-v1:sha256:68cc33f0a8a5d9319b267b1919189792901b30e95ec1d7fb18ded042064edd12:"
        }
      ]
    },
    {
      "id": "claim_77fd66358f4f42eb89de04ba0cc1eb9e",
      "statement": "A stage returning false from Apply means the pose is final rather than discarded: the component still applies the result, so returning false short-circuits the remaining stages without cancelling the tick.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MoSynthStage.cs#L41-L58",
          "version": "repo-lines-v1:sha256:7eae437dba8ae8e66867086049ea518888e4e14484ca0b687f80fe390279f49a:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L186-L212",
          "version": "repo-lines-v1:sha256:19a11fe4c15e81770f928cf13bb8a67a9b45553bcd252f4761c379f9444beb8f:"
        }
      ]
    },
    {
      "id": "claim_83e592cf7e7f4cad8f377d76ae91054d",
      "statement": "Disabling a stage skips only Apply while Init, OnValidate and OnDestroy still run, which is what stops a runtime toggle from changing the skeleton or the pose layout mid-run and reshaping the buffer under every other stage.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MoSynthStage.cs#L21-L25",
          "version": "repo-lines-v1:sha256:b520e05ffe1b15202996d51c17360502e429f53e59f5b214eb972dcf87c1e77e:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L135-L184",
          "version": "repo-lines-v1:sha256:64a07d3b21df6aee913eea85bc94c40239d6f3c0d12352b4132eb3b42d52830a:"
        }
      ]
    },
    {
      "id": "claim_0e79f1e99745403aa26f3ace1bf64939",
      "statement": "Refreshing the pipeline pose from the rig is delegated to RigPoseReader.Read, whose rate pass must run before the pose pass because it differences against the previous tick's values still held in the buffer; that ordering makes the call non-idempotent, since a second call in the same tick reports zero rates.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L246-L259",
          "version": "repo-lines-v1:sha256:b69d3c29f3e90cd96aadf718151fd03a589eafef55cab3c157fbd8c78f009d9c:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/RigPoseReader.cs#L17-L79",
          "version": "repo-lines-v1:sha256:a64b93c87236162e3d6732c969224d889f9b31b355ce0900da384a4549e91609:"
        }
      ]
    },
    {
      "id": "claim_9f3915e48b2c46d4898cb178b250200f",
      "statement": "RigPoseReader writes the pose's velocity channels as per-second rates and its angular channels as rotation vectors in radians taken the short way round, which is what the channel types specify and what SkeletonData.CharacterSpaceVelocity assumes; a zero-length tick yields a zero rate rather than a division by zero.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/RigPoseReader.cs#L44-L109",
          "version": "repo-lines-v1:sha256:e8b8bc1ddc5add5d56adbab856a1a5b2fdb9ee2ae7872d75009e8c316046f071:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/ChannelTypes.cs#L32-L43",
          "version": "repo-lines-v1:sha256:9ac56b33c6863a5f27c69eaeaf38e6e692266cad515734272155c15475aaae9a:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/RigPoseReaderTests.cs#L52-L99",
          "version": "repo-lines-v1:sha256:36e2c10d68499ddbe70e159859fea5bb5a5943210be103114ec7fbb232f52ba0:"
        }
      ]
    },
    {
      "id": "claim_cd8e013d223a4a438a1456f6eb357be6",
      "statement": "Every Transform between the skeleton's bone 0 and the MotionSynthesisComponent must be identity, because the pose is written under the component's Transform frame-locally and that is what makes the component's Transform the character frame the pose implies.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L24-L30",
          "version": "repo-lines-v1:sha256:fda96dfe3cb964da4653676391bb0601e44fa2b94451b1829604d0cb062c3279:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L246-L259",
          "version": "repo-lines-v1:sha256:b69d3c29f3e90cd96aadf718151fd03a589eafef55cab3c157fbd8c78f009d9c:"
        }
      ]
    },
    {
      "id": "claim_1edf7e725bd74c3e8f56fd6c7fbc849a",
      "statement": "The finished pose is re-anchored under the component's Transform rather than written in absolute world space, so a pose from anywhere in a database lands on the character, and the Transform is then advanced by the frame's own velocity so the character accumulates movement instead of being teleported each tick.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L262-L297",
          "version": "repo-lines-v1:sha256:a21a8d4171bd1e8f842b53aa3adf7c2f71a88db45435c6e6cadd4470b2497200:"
        }
      ]
    },
    {
      "id": "claim_f60d0033d1fa43ae80d04132f7fc83d2",
      "statement": "PoseDiscontinuity is cleared at the start of every tick and set by whichever stage replaced the pose discontinuously, and downstream blending stages read it to re-anchor; Inertialization documents a stage that jumps without raising it as a contract violation.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L95-L100",
          "version": "repo-lines-v1:sha256:73550092ab297a405cfb5a0599e20a98a073b2993f908f826df7eaf9a9663dff:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MoSynthStage.cs#L41-L58",
          "version": "repo-lines-v1:sha256:7eae437dba8ae8e66867086049ea518888e4e14484ca0b687f80fe390279f49a:"
        }
      ]
    },
    {
      "id": "claim_1cd343aed4e244e5a5f407e3ef9fcbc2",
      "statement": "Awake fails loudly and disables the component when no skeleton is assigned or when any bone fails to bind, but degrades quietly when characterRig is unset by warning and falling back to searching under the component's own transform.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L135-L184",
          "version": "repo-lines-v1:sha256:64a07d3b21df6aee913eea85bc94c40239d6f3c0d12352b4132eb3b42d52830a:"
        }
      ]
    },
    {
      "id": "claim_3772e599fcd248f7b8325a6bc27565b5",
      "statement": "When the synthesis frame rate is capped the countdown to the next tick is accumulated rather than reset, so the synthesis clock does not drift with the render rate, and OnPoseApplied does not fire on Unity frames the limiter skips.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L213-L231",
          "version": "repo-lines-v1:sha256:76645ce87f2229a0ecdb653fbc87baaff503ea13559036385f23c1c974d7aa99:"
