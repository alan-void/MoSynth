          "version": "repo-lines-v1:sha256:233b4f5750af182262e00845bec49e23b73a667af585a5feca1cd6246937dccb:"
        }
      ]
    },
    {
      "id": "claim_21d078c0f22c4a6f8a04106608a4eb5b",
      "statement": "ComputeAppliedFrame reports where a pose will be rendered — the component's Transform advanced by the frame velocity that pose carries, or unchanged while rootPositionsMask is off — and the apply path itself goes through it, so a stage that needs to know the frame its edit will land in cannot disagree with the integration that follows.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L286-L323",
          "version": "repo-lines-v1:sha256:d5f5e5235ded88e3b6fc887d7c5d78d16d7508bdc8231c8fe2ed439350afb16d:"
