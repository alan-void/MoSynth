    },
    {
      "id": "claim_3772e599fcd248f7b8325a6bc27565b5",
      "statement": "When the synthesis frame rate is capped the countdown to the next tick is accumulated rather than reset, so the synthesis clock does not drift with the render rate, and OnPoseApplied does not fire on Unity frames the limiter skips.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L213-L231",
          "version": "repo-lines-v1:sha256:76645ce87f2229a0ecdb653fbc87baaff503ea13559036385f23c1c974d7aa99:"
