          "version": "repo-lines-v1:sha256:a0cd56ce10b788e36efbbeaa14af10e6322b5ce3476d1fb32e772ddc2c46ce66:"
        }
      ]
    },
    {
      "id": "claim_31d556c9fc5b490a8aaf4ac3a0ec8929",
      "statement": "Reading a rig into a pose lives in RigPoseReader rather than on the component because the rates are the one part with a right and a wrong answer, and a MonoBehaviour method reached only from LateUpdate cannot be tested.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Pose/RigPoseReader.cs#L7-L15",
          "version": "repo-lines-v1:sha256:22497f77d323728e2d7e24387156e1ddb2435d403633e1aaffaed33509dc9a54:"
