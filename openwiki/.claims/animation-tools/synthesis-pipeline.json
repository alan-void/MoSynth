        }
      ]
    },
    {
      "id": "claim_af36b7cb1b8f4bbe95beb8efdb06969d",
      "statement": "A root correction reaches the character through bone 0's velocity channels rather than by writing the character's Transform, because the component derives the frame's own motion from those channels when it advances the character; that is the same route Inertialization writes its blended root through, and it is what lets a correction be damped and rate-limited against the animation's own travel.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Stages/RootFollowStage.cs#L94-L133",
          "version": "repo-lines-v1:sha256:d0c63a219e44ca6b1bf95fd4e6a559e22b96e27c622eb644b8591dc7491840f3:"
        },
        {
