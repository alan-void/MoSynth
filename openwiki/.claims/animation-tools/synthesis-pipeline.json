          "version": "repo-lines-v1:sha256:8109133738d4b5ef86b5691ff0429ade42470959e9fdbabca622a873fb0c7662:"
        }
      ]
    },
    {
      "id": "claim_7c6e888d3db141d58fd798ac6f70716f",
      "statement": "The component's root motion state is routed rather than stored: RootPosition and RootRotation read its own Transform, and RootVelocity and RootAngularVelocity are re-derived each tick from the pose read off the rig. Only SetPosAdjustment, SetRotAdjustment, GetMainPositionFeature and GetEnvironmentFeature still throw NotImplementedException, kept because they are the contract the crowd and collision control inputs were written against.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L330-L402",
          "version": "repo-lines-v1:sha256:d195dc16804ae2331eacc3e0955204637567f49c87542febd9e687e983591f31:"
        },
        {
