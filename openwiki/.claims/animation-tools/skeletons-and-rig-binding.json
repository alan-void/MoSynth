          "version": "repo-lines-v1:sha256:0ce271de7a81519ef0f0910451d3b5583253201ec21438a31a6faf0d363385b6:"
        }
      ]
    },
    {
      "id": "claim_66c4e3ee89ac4585acd0ce3836cd21ff",
      "statement": "MatchesFrom asks whether another skeleton is embedded in this one starting at a given bone, shifting parent indices by that offset, so a rig nested under extra ancestors such as an armature node can be compared against the bare hierarchy.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/Skeleton.cs#L185-L211",
          "version": "repo-lines-v1:sha256:88a76d79e33f9b58e2e4ef79180ee681e7116ac36643460cf3dcee1400f51827:"
