    },
    {
      "id": "claim_a10f9fad0bb3455b982233824f472de5",
      "statement": "SkeletonBone stores its Skeleton by value rather than by reference, so an asset with several bone-reference fields holds several Skeleton instances over one rig; the derived bone walk is therefore cached per root Transform in a static map rather than per instance, so those instances share one walk, one parent-index array and one Domain-allocated SkeletonData.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/SkeletonBone.cs#L7-L21",
          "version": "repo-lines-v1:sha256:c5ec5f45df5dbfb34ba5a063e5ee06fe7c514b0d352048272e4c7a11c04f5eb8:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/Skeleton.cs#L236-L256",
          "version": "repo-lines-v1:sha256:8d5ee7f4da1c6532c0ea2130a3da7493bad07ac5f9e6e7ca5c80a50ce8c1ddfc:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Tests/Editor/SkeletonTests.cs#L171-L183",
          "version": "repo-lines-v1:sha256:58c74a62481550f80c196920dafc8eef6dfeecb9d694b535167a4e72dc4a4030:"
        }
      ]
    },
    {
      "id": "claim_32acb750a0004057b9491db7cd2ee256",
      "statement": "SkeletonData's arrays are allocated with Allocator.Domain and live for the domain's lifetime, so callers must never dispose them.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/Skeleton.cs#L135-L169",
          "version": "repo-lines-v1:sha256:6cb9b2cdec529d98973e86457b429d9e1a69ad254d06e4c50f686788f92e1b13:"
