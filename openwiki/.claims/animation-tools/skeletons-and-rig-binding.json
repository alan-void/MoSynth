          "version": "repo-lines-v1:sha256:74c5a5fe59aa04a063073a0328e870089d9475a1703363deefec390179bbfd30:"
        }
      ]
    },
    {
      "id": "claim_640f5a4983094bfbbd9695f7d5bac73a",
      "statement": "Because a bone's local frame carries whatever roll the rig was authored with, the axis meaning \"forward\" differs per rig and must be read from the rest pose via RestLocalAxis rather than assumed to be a constant.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/Skeleton.cs#L127-L133",
          "version": "repo-lines-v1:sha256:12e84efb937e305944be1b5f7cf77e6804f841a1ed59ec08cad405d41eae5486:"
