    },
    {
      "id": "claim_34ce8e7c016246448d2a58ec1d282c93",
      "statement": "Binding failures are non-fatal at the Skeleton layer — an unresolvable bone logs an error and leaves its slot null so the caller decides severity — while MotionSynthesisComponent counts the nulls and disables itself; duplicate bone names under the root only produce a warning, since the first depth-first match silently wins.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/SkeletonBoneOverrides.cs#L68-L112",
