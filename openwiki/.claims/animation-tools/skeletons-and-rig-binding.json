  "claims": [
    {
      "id": "claim_bbfded48a8f14b4d9775eed28ee72976",
      "statement": "A Skeleton is not a stored bone list but a single serialized root Transform plus a derived preorder depth-first walk of its subtree, and that walk is the project-wide bone order every downstream index is expressed against.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/Skeleton.cs#L9-L28",
          "version": "repo-lines-v1:sha256:4e89a3e0dc73709eb2bdec6dc786fff04d3bbcdf8024b07d4dc891c1a1263659:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/Skeleton.cs#L213-L234",
          "version": "repo-lines-v1:sha256:24abcef9b9fdc84afd09223404358cc4f800853a132213335f04453c45e13b23:"
        }
      ]
    },
    {
      "id": "claim_be77de5321ce4f5dae7cc5cbc9541dbb",
      "statement": "A Skeleton must point at an asset rig rather than a scene rig, because the rest pose is read live off the Transforms: a skeleton built over an animated scene rig reports the current pose as the rest pose, which silently corrupts FK with no detectable error.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/Skeleton.cs#L14-L24",
          "version": "repo-lines-v1:sha256:ce8d22a360aef437fedf6dc2b00ed8c176255a7c90ee8cf30c6de05457418c5d:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Core/MotionSynthesisComponent.cs#L49-L74",
          "version": "repo-lines-v1:sha256:75c48add2ce2b1c3eaf28b7957534c5ebbad95d9b1eb876f38217a13289225c9:"
        }
      ]
    },
    {
      "id": "claim_0cabb37e3856436ebb2b1235fd1296d9",
      "statement": "The asset-rig requirement is enforced in exactly one place and only in the Editor — SkeletonAnimation.TryValidate's IsPersistent check — so a skeleton assigned by script or through a prefab variant bypasses every guard, since MotionSynthesisComponent's own Skeleton field has no runtime equivalent.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Animation/SkeletonAnimation.cs#L98-L107",
          "version": "repo-lines-v1:sha256:ded8b57079edf24e36709344925fefca7e24071dccaac1015b7c42e9bbfc70d7:"
        }
      ]
    },
    {
      "id": "claim_a15a42183b7b4a709a572264994dd8fb",
      "statement": "Everything beneath a skeleton's root Transform becomes a bone, so a mesh node, attachment point or IK helper parented under the root shifts every bone index after it and silently invalidates features, contacts and serialized databases.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/Skeleton.cs#L14-L24",
          "version": "repo-lines-v1:sha256:ce8d22a360aef437fedf6dc2b00ed8c176255a7c90ee8cf30c6de05457418c5d:"
        }
      ]
    },
    {
      "id": "claim_656084f3645249d1b07be59cdf1bafd6",
      "statement": "Bone ids are the bone index plus one so that zero unambiguously means unset, and IndexOfId returns -1 for id 0 or any id past the bone count.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/Skeleton.cs#L96-L107",
          "version": "repo-lines-v1:sha256:233acf203aba8b00ea99821297c8f248f1195f345e0d0a1dcff4dade7509193c:"
        },
        {
