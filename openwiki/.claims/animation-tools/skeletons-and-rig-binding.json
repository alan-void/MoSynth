        }
      ]
    },
    {
      "id": "claim_928ff8d4cf6b45f6a6946f2ff2428ea2",
      "statement": "SkeletonBoneOverrides binds an asset skeleton to a live scene rig by bone name because the two are different object graphs sharing no Transforms, so a name is the only identity that survives the crossing; per-bone overrides are the escape hatch for a bone named differently or living outside the walk.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/SkeletonBoneOverrides.cs#L7-L26",
          "version": "repo-lines-v1:sha256:5261fea334c44ed43705f894e157b3486f6208c736ced170476943ef0388cfed:"
