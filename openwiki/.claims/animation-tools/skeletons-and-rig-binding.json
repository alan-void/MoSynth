    {
      "id": "claim_3647c992fcbd4c449363d4a3c5e073c9",
      "statement": "The parent-of-every-bone-precedes-it invariant lets SkeletonData compute forward kinematics in a single forward pass instead of walking each bone's parent chain.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/SkeletonData.cs#L26-L50",
          "version": "repo-lines-v1:sha256:837f22f4c5cf2c72072f7015f16782eaa099288413368909f8cff579fb7f2ccf:"
