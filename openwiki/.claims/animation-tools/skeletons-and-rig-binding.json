    },
    {
      "id": "claim_06d6ac3b2a274a69ac5ccb7479914cc4",
      "statement": "Derived skeleton data is invalidated only manually, because neither the cached bone list nor ContentHash notices a rig changing underneath a live skeleton — and PoseLayout's cache is keyed on that hash, so a reimport or bone-tree edit requires an explicit Invalidate call.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/Skeleton.cs#L341-L355",
          "version": "repo-lines-v1:sha256:f798c3464d34c6f1db3c52fac9f45a29494e5b26678a6ebbbbee0ddb8c1ce857:"
        }
      ]
    },
    {
      "id": "claim_fad18b9975984d558827b6dfb6a4e196",
      "statement": "StructurallyEqual compares bone count, names and parent indices while deliberately ignoring the rest pose, so two rigs with identical structure but different bone lengths compare equal.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Skeleton/Skeleton.cs#L171-L183",
          "version": "repo-lines-v1:sha256:14af1a9e421525efe73320546d8fe509dea12bb77fd3114e01734757a262d6d5:"
