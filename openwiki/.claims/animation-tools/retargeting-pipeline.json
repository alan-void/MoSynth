    {
      "id": "claim_092a32b079374705921a10522b3667b4",
      "statement": "A posed FBX bind is invisible to a Blender re-import, which reconstructs the armature from the file's bind-pose data and shows a clean rest pose; only Unity's importer substitutes the first take, so the imported hierarchy has to be checked in Unity.",
      "evidence": [
        {
          "resource": "repo://Tools/Retargeting/batch_retarget.py#L503-L533",
          "version": "repo-lines-v1:sha256:fbe9db6932b1fe344ded06e62a63de0df9fdf4c01994e626031d056e66cc2294:"
