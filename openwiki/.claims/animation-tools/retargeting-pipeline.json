        }
      ]
    },
    {
      "id": "claim_ffd4a1798d994bc89bbb92da99b28261",
      "statement": "The Bandai-Namco and LAFAN setups target different model rigs — the corrected 22-bone rig versus the 85-bone Model:* rig — so clips from the two datasets cannot share one MotionMatchingData skeleton until LAFAN is re-retargeted onto the corrected rig.",
      "evidence": [
        {
          "resource": "repo://Assets/AnimationTools/Editor/Retargeting/RetargetBatchSettings.cs#L16-L29",
          "version": "repo-lines-v1:sha256:e5ca4fd7ab6bcd6e9570696b080049619ba54a000fbc1585e98de5c3d74bc6b3:"
        },
        {
