    },
    {
      "id": "claim_fb6d3becc7434db6a9892de77a7e85c4",
      "statement": "batch_retarget.py moves the T-Pose track to the bottom of the model rig's NLA stack immediately before export, because push_to_nla appends a new track per clip and would otherwise bury the rest track the blend was saved with; a setup lacking that track now raises rather than exporting a posed bind.",
      "evidence": [
