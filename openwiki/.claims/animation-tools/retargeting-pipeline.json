  "claims": [
    {
      "id": "claim_8ddbb795c86e4da49515e83a653a6ef8",
      "statement": "A retarget setup's cleaned skeleton is the calibration pose for stage two, because Rokoko builds a helper bone at each target bone's rest transform, parents it to the mapped source bone, and copies its rotation onto the target — making the retarget a pure world-space rotation delta from the source's own rest pose.",
      "evidence": [
        {
          "resource": "repo://Tools/Retargeting/batch_retarget.py#L328-L361",
          "version": "repo-lines-v1:sha256:df53b0ac1370fbb9cdde0e875e900d81395fa23dda75d612901faed659787258:"
        },
        {
          "resource": "repo://Tools/Retargeting/README.md",
          "version": "repo-file-v1:sha256:4de281ad07212d7bf9f53e56d8ef5b5462ce9bddae25fd9d23257d27e394be61"
        }
      ]
    },
    {
      "id": "claim_b4547abffc704a429bda7a65d05a7f6d",
      "statement": "Stage one needs IK only when cleaning changed the cleaned skeleton's chain lengths; where the cleaned skeleton is a rotation-only copy of the source and no BVH joint but the root translates, COPY_ROTATION plus COPY_LOCATION on the root reproduces the source exactly.",
      "evidence": [
        {
          "resource": "repo://Tools/Retargeting/batch_retarget.py#L311-L325",
          "version": "repo-lines-v1:sha256:4103c1971e697873b65796e62cf839225f3490c8bd1730c4f9b3b5186155d279:"
