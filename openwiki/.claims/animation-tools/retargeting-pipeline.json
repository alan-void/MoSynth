        }
      ]
    },
    {
      "id": "claim_ffd4a1798d994bc89bbb92da99b28261",
      "statement": "Both dataset setups now retarget onto the same corrected 22-bone rig, so LAFAN and Bandai-Namco clips can share one MotionMatchingData skeleton; LAFAN's setup reaches it in a single Rokoko pass from the BVH rather than through the retired 85-bone Model:* rig.",
      "evidence": [
        {
          "resource": "repo://Tools/Retargeting/make_lafan_corrected_setup.py#L29-L39",
          "version": "repo-lines-v1:sha256:c27be4155d510e6bd716909f32cf97c63798369505d8ec01eb0bdcd5d3e3ad62:"
        },
