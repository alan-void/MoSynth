        }
      ]
    },
    {
      "id": "claim_953607b3210f4ed2b15ff88dff9f128b",
      "statement": "A retarget setup for a new target rig is composed from existing blends by script rather than authored by hand when no judgement remains: the cleaned skeleton that serves as stage two's calibration pose already exists in the old setup, and the target rig already exists as a proven export configuration in another setup, so only the Rokoko target pointer and the bone list's target names change.",
      "evidence": [
        {
          "resource": "repo://Tools/Retargeting/make_lafan_corrected_setup.py#L1-L15",
          "version": "repo-lines-v1:sha256:c306aaca52e051c78b0df101c223ed7ef60e2528f9ea08491ece65347284833a:"
