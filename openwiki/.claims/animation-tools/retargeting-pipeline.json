          "version": "repo-lines-v1:sha256:e41658c6c2c1796def1c48dd6691a3f3b314694651aafe52dbe5e054ed6c5a98:"
        },
        {
          "resource": "repo://Tools/Retargeting/batch_retarget.py#L581-L651",
          "version": "repo-lines-v1:sha256:6a7f4d7b2b8f52e4f94839522d20d89825c9818b2e16d3d0fda94134fc88df00:"
        }
      ]
    },
    {
      "id": "claim_4b9cc6c4e90e4157b53c5d4fc40800b4",
      "statement": "The FBX export must send unit scaling to the file header rather than to each object transform, because apply_scale_options=\"FBX_SCALE_NONE\" writes it as a scale of 100 on the armature node, and Unity's rigid FK ignores scale — so every bone's rest offset imports 100x too small while the root's animated curve stays in metres, collapsing the whole skeleton onto the root with no error beyond a non-unit-scale warning.",
      "evidence": [
        {
          "resource": "repo://Tools/Retargeting/batch_retarget.py#L503-L533",
          "version": "repo-lines-v1:sha256:fbe9db6932b1fe344ded06e62a63de0df9fdf4c01994e626031d056e66cc2294:"
        },
        {
          "resource": "repo://Assets/AnimationTools/Runtime/Animation/AnimationClipBaker.cs#L215-L230",
          "version": "repo-lines-v1:sha256:6a5af5bca2ea86031cdbf22f1dd6debe2ec5af2d1b4c1ce196fb0b880e8066e6:"
        }
      ]
    },
    {
      "id": "claim_8aec7395d09c46f09a7d63a114d4f766",
      "statement": "An exported Bandai-Namco FBX and the corrected rig blend both import as the same 27-bone tree under Hips — the 22 animated bones plus five \"_end\" leaves Blender's exporter synthesises — so a character can take its live rig from the blend while its skeleton comes from the FBX the network was trained on.",
      "evidence": [
        {
          "resource": "repo://Tools/Retargeting/batch_retarget.py#L503-L533",
          "version": "repo-lines-v1:sha256:fbe9db6932b1fe344ded06e62a63de0df9fdf4c01994e626031d056e66cc2294:"
