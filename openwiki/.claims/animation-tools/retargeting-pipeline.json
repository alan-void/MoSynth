          "version": "repo-lines-v1:sha256:c809fbfb9639b2eef3fd283b2d552ebfc3a2b649eb319a3fc1f60524b0b32e5d:"
        }
      ]
    },
    {
      "id": "claim_5f1227d240b148ee85e2eb6e763b18b1",
      "statement": "Unity poses an imported model's hierarchy from the first animation take's first frame rather than from the FBX's bind pose, so whichever take an exported FBX leads with becomes the rig's rest pose for everything that reads it live off the Transforms.",
      "evidence": [
        {
          "resource": "repo://Tools/Retargeting/batch_retarget.py#L469-L501",
          "version": "repo-lines-v1:sha256:92cbe700523b7ccabc8fdf3cb89e62f6032c4d7c89254195903d0d572fef5a70:"
